<?xml version="1.0" encoding="utf-8"?>

                                                        

    

                 
                        
                                                                          
           

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" android:tag="layout/activity_pickup_drop_search_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/button_accept">

            <ImageView
                android:id="@+id/back_icon"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginStart="10dp"
                android:layout_gravity="center"
                android:padding="5dp"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_back_white" />

            <ImageView
                android:id="@+id/header_titleTxt"
                style="@android:style/TextAppearance.Medium"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_centerInParent="true"
                android:contentDescription="@null"
                android:padding="3dp"
                android:textColor="@color/header_text"
                android:visibility="invisible" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:foreground="@drawable/background_shadow"
            android:visibility="gone">
            <!-- YOUR STUFF HERE -->
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/searchlay"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/pickup_pinlay"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/drop_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:paddingStart="@dimen/taxi__search_padding_medium"
                        android:paddingEnd="@dimen/dp_8"
                        app:srcCompat="@drawable/ic_pickup_drop" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/pickupp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@+id/pickup_pinlay"
                    android:background="@null"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/dp_10"
                        android:paddingTop="@dimen/dp_5"
                        android:text="PICKUP"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/currentlocTxt"
                        style="@style/enterTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:background="@android:color/transparent"
                        android:fadingEdge="horizontal"
                        android:hint="@string/picklocation"
                        android:imeOptions="flagNoExtractUi"
                        android:lines="1"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:paddingStart="@dimen/dp_10"
                        android:paddingTop="@dimen/taxi__search_padding_medium"
                        android:paddingEnd="@dimen/pad_15dp"
                        android:paddingBottom="@dimen/taxi__search_padding_medium"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintcolor"
                        android:textSize="18sp" />

                </LinearLayout>

                <View
                    android:id="@+id/pickup_drop_Sep"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_below="@id/pickupp"
                    android:layout_toEndOf="@+id/pickup_pinlay"
                    android:background="@color/linebottom_light" />


                <LinearLayout
                    android:id="@+id/dropppp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/pickup_drop_Sep"
                    android:layout_toEndOf="@id/pickup_pinlay"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/dp_2"
                        android:paddingStart="@dimen/dp_10"
                        android:text="DROP-OFF"
                        android:textSize="12sp"
                        android:visibility="visible" />

                    <EditText
                        android:id="@+id/taxi__locationsearch_edittext_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_weight="1.0"
                        android:background="@null"
                        android:ellipsize="none"
                        android:fadingEdge="horizontal"
                        android:fadingEdgeLength="16.0dip"
                        android:hint="@string/enter_dest"
                        android:imeOptions="actionSearch"
                        android:inputType="textNoSuggestions"
                        android:paddingStart="@dimen/dp_10"
                        android:paddingTop="@dimen/taxi__search_padding_medium"
                        android:paddingEnd="@dimen/pad_15dp"
                        android:paddingBottom="@dimen/taxi__search_padding_medium"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintcolor"
                        android:textSize="18sp" />

                    <ImageButton
                        android:id="@+id/taxi__locationsearch_imagebutton_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:layout_gravity="end|center"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:paddingLeft="@dimen/taxi__search_padding_large"
                        android:paddingRight="@dimen/taxi__search_padding_large"
                        android:src="@drawable/close"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/add_stop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".15"
                        android:contentDescription="@null"
                        android:padding="@dimen/dp_5"
                        android:src="@drawable/plus1"
                        android:visibility="gone" />

                </LinearLayout>


            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:foreground="@drawable/background_shadow"
                android:visibility="visible">
                <!-- YOUR STUFF HERE -->
            </FrameLayout>

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/locationList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </androidx.recyclerview.widget.RecyclerView>

        <FrameLayout
            android:id="@+id/searchFrag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1" />


        <LinearLayout
            android:id="@+id/map_redirctTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/dp_10">

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/dp_10"
                app:srcCompat="@drawable/ic_drop_pin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:fontFamily="@font/normalfont"
                android:text="@string/locate_on_map"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />


        </LinearLayout>

    </LinearLayout>


         