<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/headlayout"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/black"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:visibility="visible"
  >

    <TextView
        android:id="@+id/header_titleTxt"
        style="@android:style/TextAppearance.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="35dp"
        android:paddingTop="@dimen/dp_3"
        android:paddingEnd="@dimen/dp_3"
        android:paddingBottom="@dimen/dp_3"
        android:textColor="@color/white"
        android:fontFamily="@font/boldfont"
        app:layout_constraintBottom_toTopOf="@id/layoutShadow"
        app:layout_constraintEnd_toStartOf="@id/barrierRight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"
        tools:text="@string/wallet" />

    <LinearLayout
        android:id="@+id/leftIconTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/layoutShadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/leftIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_icon"
            android:drawablePadding="05dp"
            android:gravity="center"
            android:fontFamily="@font/normalfont"

            android:textColor="@color/white"
            android:visibility="visible" />

        <TextView
            android:id="@+id/back_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/normalfont"

            android:background="@drawable/ic_back_white"
            android:visibility="gone" />


        <ImageView
            android:id="@+id/back_img"
            android:layout_width="@dimen/pad_30dp"
            android:layout_height="@dimen/pad_30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_back_white"
            android:visibility="visible" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="layoutRight,emergency_lay,layout_skip" />

    <LinearLayout
        android:id="@+id/layout_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="@dimen/dp_10"
        android:layout_weight="1.1"
        android:gravity="right"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/layoutShadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txt_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="right"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:fontFamily="@font/normalfont"

            android:paddingBottom="6dp"
            android:text="@string/skip_"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emergency_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center"
        android:layout_marginLeft="5dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutShadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/txt_emergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:layout_marginRight="10dp"
            android:background="@drawable/oval_red"
            android:gravity="center"
            android:maxWidth="150dp"
            android:minWidth="70dp"
            android:minHeight="30dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:text="@string/emergency"
            android:fontFamily="@font/normalfont"

            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layoutShadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/rightlay"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|right"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/rightIconTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="3dp"
                android:fontFamily="@font/normalfont"

                android:textColor="@drawable/text_color_black_to_white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editfavlay"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:gravity="right"
            android:visibility="gone">

            <TextView
                android:id="@+id/editIconTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/normalfont"

                android:visibility="gone" />

            <TextView
                android:id="@+id/addIconTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/button_accept"
                android:padding="3dp"
                android:text="@string/add"
                android:fontFamily="@font/normalfont"

                android:textColor="@color/white" />
        </LinearLayout>


    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutShadow"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:foreground="@drawable/background_shadow"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
