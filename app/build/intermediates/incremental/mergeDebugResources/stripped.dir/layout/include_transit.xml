<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchlayl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/estimate_fare"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="@color/white"
        android:gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/pad_20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/dp_10"
            android:src="@drawable/cash_b" />

        <TextView
            android:id="@+id/txt_estimate"
            style="@style/enterTxt"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="@dimen/pad_10dp"
            android:paddingEnd="@dimen/pad_10dp"
            android:text="@string/estimate_fare"
            android:textColor="@color/black"
            android:textSize="15sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/t_pickup_time_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:padding="@dimen/dp_10"
            android:text="@string/picktime"
            android:textColor="@color/black"
            android:visibility="gone" />

        <TextView
            android:id="@+id/call_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/call"
            android:drawablePadding="@dimen/dp_5"
            android:padding="10dp"
            android:text="@string/call"
            android:textColor="@color/button_accept"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:id="@+id/time_sep"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/linebottom_light"
        android:visibility="gone" />

    <com.taximobility.pdview.PickupDropView
        android:id="@+id/pd_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/elevated_bg"
        android:orientation="vertical"
        android:padding="@dimen/dp_1" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEditPickUpDrop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/semi_circle_shape"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_5"
        android:text="@string/edit"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_8"
        android:visibility="gone"
        android:textColor="@color/white" />

</LinearLayout>
