<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootlay"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:clickable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        >

        <include
            layout="@layout/include_headler"
            android:layout_width="fill_parent"
            android:visibility="gone"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:background="@color/button_accept" />

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:layout_marginTop="50dp"
                android:layout_marginRight="@dimen/dp_15"
                android:orientation="vertical"
            >

                <LinearLayout
                    android:id="@+id/loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_gravity="center"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/giff"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/walletPageIcon"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_wallet_new" />


                    <TextView
                        android:id="@+id/walletbalTxt"
                        style="@style/enterTxt"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/boldfont"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="40sp" />

                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="0.5dp"
                        android:background="#dcdcdc" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingRight="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10">

                        <ImageView
                            android:id="@+id/info_msh"
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_info_white" />

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_centerVertical="true"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/info_msh"
                            android:fontFamily="@font/normalfont"
                            android:text="@string/walletmsg"
                            android:textColor="@color/white"
                            android:textSize="13dp" />

                    </RelativeLayout>
                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/nested_scrollview"
                        android:layout_width="match_parent"
                        android:background="@drawable/white_corner_bg"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/bottom_lay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingTop="@dimen/dp_10"
                                    >

                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical">




                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_centerVertical="true"
                                            android:id="@+id/lay_add_amt"
                                            android:orientation="vertical">

                                            <LinearLayout
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="10dp"
                                                android:orientation="horizontal">

                                                <LinearLayout
                                                    android:layout_width="fill_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginLeft="5dp"
                                                    android:layout_marginRight="5dp"
                                                    android:layout_marginTop="10dp"
                                                    android:layout_weight="1"
                                                    android:background="@color/white"
                                                    android:gravity="center"
                                                    >

                                                    <TextView
                                                        android:id="@+id/monoption1"
                                                        style="@style/enterTxt"
                                                        android:layout_width="fill_parent"
                                                        android:layout_height="wrap_content"
                                                        android:fontFamily="@font/normalfont"
                                                        android:padding="10dp"
                                                        android:background="@drawable/draw_edittext_bg"
                                                        android:gravity="center"

                                                        android:text="100"
                                                        android:textColor="@color/textviewcolor_dark" />
                                                </LinearLayout>
                                                <LinearLayout
                                                    android:layout_width="fill_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginLeft="5dp"
                                                    android:layout_marginRight="5dp"
                                                    android:layout_marginTop="10dp"
                                                    android:layout_weight="1"
                                                    android:background="@color/white"
                                                    android:gravity="center"
                                                    >
                                                    <TextView
                                                        android:id="@+id/monoption2"
                                                        style="@style/enterTxt"
                                                        android:layout_width="fill_parent"
                                                        android:layout_height="wrap_content"
                                                        android:padding="10dp"
                                                        android:background="@drawable/draw_edittext_bg"
                                                        android:gravity="center"
                                                        android:text="200"
                                                        android:fontFamily="@font/normalfont"
                                                        android:textColor="@color/textviewcolor_dark" />
                                                </LinearLayout>
                                                <LinearLayout
                                                    android:layout_width="fill_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginLeft="5dp"
                                                    android:layout_marginRight="5dp"
                                                    android:layout_marginTop="10dp"
                                                    android:layout_weight="1"
                                                    android:background="@color/white"
                                                    android:gravity="center"
                                                    >
                                                    <TextView
                                                        android:id="@+id/monoption3"
                                                        style="@style/enterTxt"
                                                        android:layout_width="fill_parent"
                                                        android:layout_height="wrap_content"
                                                        android:padding="10dp"
                                                        android:background="@drawable/draw_edittext_bg"
                                                        android:gravity="center"
                                                        android:text="300"
                                                        android:fontFamily="@font/normalfont"
                                                        android:textColor="@color/textviewcolor_dark" />
                                                </LinearLayout>
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginLeft="5dp"
                                                android:layout_marginRight="5dp"
                                                android:layout_marginTop="10dp"
                                                android:background="@drawable/draw_edittext_bg"
                                                android:orientation="horizontal">

                                                <TextView
                                                    android:id="@+id/cur_sym"
                                                    style="@style/enterTxt"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:paddingLeft="10dp"
                                                    android:text="$" />

                                                <EditText
                                                    android:id="@+id/addmoneyEdt"
                                                    style="@style/enterTxt"
                                                    android:layout_width="fill_parent"
                                                    android:layout_height="wrap_content"
                                                    android:textColorHint="@color/hintcolor"
                                                    android:textColor="@color/edittextcolor"
                                                    android:background="@color/transparent"
                                                    android:gravity="center_vertical"
                                                    android:inputType="number"
                                                    android:fontFamily="@font/normalfont"
                                                    android:imeOptions="actionDone"
                                                    android:padding="10dp"
                                                    android:singleLine="true" />

                                            </LinearLayout>

                                            <TextView
                                                android:id="@+id/procodeTxt"
                                                style="@style/enterTxt"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:layout_margin="10dp"
                                                android:fontFamily="@font/normalfont"
                                                android:gravity="center"
                                                android:singleLine="true"
                                                android:text="@string/have_promocode"
                                                android:textColor="@color/button_accept" />


                                        </LinearLayout>



                                    </RelativeLayout>



                                </LinearLayout>



                            </LinearLayout>


                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </LinearLayout>


        </FrameLayout>


        <TextView
            android:id="@+id/addmoneyBut"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/tool_bar_bottom"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/sp_14"
            android:gravity="center"
            android:background="@drawable/button_rect"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/addmoney"
            android:textSize="@dimen/sp_16"
            android:textAllCaps="false"
            android:fontFamily="@font/normalfont"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>



</FrameLayout>