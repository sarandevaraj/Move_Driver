<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_containlay"
    android:layout_width="fill_parent"
    android:clickable="true"
    android:focusable="true"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        layout="@layout/include_headler"
        android:layout_width="fill_parent"
        android:visibility="gone"
        android:layout_height="56dp" />

    <ScrollView
        android:id="@+id/about_contain"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_10"
android:padding="@dimen/dp_10"
           android:layout_margin="@dimen/dp_10"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ride_from_anywhere"

                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/boldfont"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:text="@string/about_sub_title"
                android:textColor="@color/black"
                android:textSize="20sp" />


            <TextView
                android:id="@+id/bold_title_below"

                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:text="@string/site_desc"
                android:textColor="@color/sub_heading"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:textSize="18sp" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1dp"
          android:layout_marginTop="@dimen/dp_10"
                android:background="@color/separator_line" />
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:orientation="vertical">


                <FrameLayout
                    android:id="@+id/rateapplay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:onClick="clickMethod"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"

                    android:paddingRight="12dp">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"

                        android:textSize="18sp"
                        android:text="@string/rateapp"
                        android:textColor="@color/sub_heading" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:src="@drawable/right_arrow" />
                </FrameLayout>

                <!--<View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"

                    android:background="@color/line_grey" />-->

                <FrameLayout
                    android:id="@+id/likfblay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_gravity="center_vertical"
                    android:onClick="clickMethod"

                    >

                    <TextView

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/likefb"
                        

                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:src="@drawable/right_arrow"
                        android:visibility="gone"/>
                </FrameLayout>

               <!-- <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"

                    android:background="@color/line_grey" />-->

                <FrameLayout
                    android:id="@+id/fllwtwlay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"

                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"

                    android:onClick="clickMethod">

                    <TextView

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/followtw"
                        
                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:src="@drawable/right_arrow" />
                </FrameLayout>

                <!--<View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/line_grey" />-->
            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_10"

                android:background="@color/separator_line" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"

                android:orientation="vertical">

                <TextView

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"

                    android:text="@string/legal"
                    android:fontFamily="@font/boldfont"
                    android:textColor="@color/block"
                    android:textSize="20sp"
                    android:paddingBottom="@dimen/dp_10"/>

                <FrameLayout
                    android:id="@+id/termslay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:onClick="clickMethod">

                    <TextView

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/termcond"

                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:src="@drawable/right_arrow" />
                </FrameLayout>


                <FrameLayout
                    android:id="@+id/privacypolicylay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"

                    android:onClick="clickMethod">

                    <TextView

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/policy"
                        
                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:src="@drawable/right_arrow" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/cancellation_policy"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:onClick="clickMethod"
                    android:visibility="visible">

                    <TextView

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/cancellation_policy"

                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:src="@drawable/right_arrow" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/refund_policy"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:onClick="clickMethod"
                    android:visibility="visible">

                    <TextView

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/refund_policy"

                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|right"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:src="@drawable/right_arrow" />
                </FrameLayout>

            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@color/separator_line" />
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:orientation="vertical">

                <TextView

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"

                    android:text="@string/link"
                    android:fontFamily="@font/boldfont"
                    android:textColor="@color/block"
                    android:textSize="20sp" />

                <!--<View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/line_grey" />-->

                <RelativeLayout
                    android:id="@+id/fblinklay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:onClick="clickMethod"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/fb_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"

                        android:src="@drawable/invite_fb" />

                    <TextView
                        android:id="@+id/fblink"

                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/dp_5"
                        android:layout_toLeftOf="@+id/backArrowFb"

                        android:layout_toRightOf="@id/fb_icon"

                        android:text="@string/facebook"
                        android:textColor="@color/sub_heading"
                        android:textSize="18sp"


                        />

                    <ImageView
                        android:id="@+id/backArrowFb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center_vertical"
                        android:paddingRight="10dp"
                        android:visibility="gone"
                        android:textSize="@dimen/text_normal"
                        android:src="@drawable/right_arrow" />
                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/twlinklay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:gravity="center_vertical"
                    android:onClick="clickMethod">

                    <ImageView
                        android:id="@+id/twicon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"

                        android:src="@drawable/invite_twitter" />

                    <ImageView
                        android:id="@+id/backArrowTw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center_vertical"
                        android:paddingRight="10dp"
                        android:src="@drawable/right_arrow"
                        android:visibility="gone"
                        android:textSize="@dimen/text_normal" />

                    <TextView
                        android:id="@+id/twlink"

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/dp_5"
                        android:layout_toLeftOf="@+id/backArrowTw"
                        android:layout_toRightOf="@+id/twicon"
                        android:text="@string/twitter"

                        android:textColor="@color/sub_heading"
                        android:textSize="18sp" />
                </RelativeLayout>


            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>