<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/corner_over_wallet"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sheet_title"
        style="@style/enterTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_8"
        android:drawablePadding="15dp"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/Referalwithdraw_request"
        android:textColor="@color/black"
        android:textSize="@dimen/dp_16"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:background="@color/separator_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/availed_lbl"
            style="@style/enterTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_weight="2"
            android:drawablePadding="15dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/payment_availed"
            android:textColor="@color/sub_heading"
            android:textSize="@dimen/text_dialog_small" />

        <TextView
            android:id="@+id/paymentavailedTxt"
            style="@style/enterTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:drawablePadding="15dp"
            android:gravity="end"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/block"
            android:text=""
            android:textSize="@dimen/text_dialog_small" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/pending_lbl"
            style="@style/enterTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_weight="2"
            android:drawablePadding="15dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/payment_request"
            android:textColor="@color/sub_heading"
            android:textSize="@dimen/text_dialog_small" />

        <TextView
            android:id="@+id/paymentpendingTxt"
            style="@style/enterTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:drawablePadding="15dp"
            android:gravity="end"
            android:paddingTop="5dp"
            android:textColor="@color/block"
            android:paddingBottom="5dp"
            android:text=""
            android:textSize="@dimen/text_dialog_small" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/withdraw_lbl"
            style="@style/enterTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_weight="2"
            android:drawablePadding="15dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/withdraw_amount"
            android:textColor="@color/sub_heading"
            android:textSize="@dimen/text_dialog_small" />

        <TextView
            android:id="@+id/withdrawamountTxt"
            style="@style/enterTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:drawablePadding="15dp"
            android:gravity="end"
            android:textColor="@color/block"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text=""
            android:textSize="@dimen/text_dialog_small" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="04dp">

        <Button
            android:id="@+id/cancelbtn"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_5"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/sub_heading_light"
            android:textSize="@dimen/sp_16" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/separator_line"
            android:visibility="gone" />

        <Button
            android:id="@+id/okbtn"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/button_rect"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/white"

            android:textSize="@dimen/text_dialog_small" />
    </LinearLayout>
</LinearLayout>