<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                         

    
                                           

                 
                              
                                                                                
           


    <!--  <include
          layout="@layout/pickup_drop"
          bind:myViewModel="@{myViewModel}" />-->


    <RelativeLayout
        android:id="@+id/relativelay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/draw_curve_rect"
        android:layout_marginBottom="@dimen/dp_40"
        android:tag="layout/search_location_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bind="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/searchlay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
       >

        <FrameLayout
            android:id="@+id/pickup_pinlay"
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:visibility="visible"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_centerInParent="true"
            android:layout_alignParentStart="true">

            <ImageView
                android:id="@+id/drop_pin"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pad_100dp"
                android:layout_gravity="center_vertical|center_horizontal"
                android:contentDescription="@null"
                android:paddingStart="@dimen/taxi__search_padding_medium"
                android:paddingEnd="@dimen/dp_8"
                app:srcCompat="@drawable/ic_pickup_drop"
                android:gravity="bottom"/>
        </FrameLayout>


        <LinearLayout
                android:id="@+id/pick_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/pickup_pinlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_marginTop="@dimen/dp_20"
                android:orientation="vertical"
                android:weightSum="1">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PICKUP"
                android:padding="@dimen/dp_2"
                android:textSize="10sp"
                android:paddingStart="@dimen/dp_10"
                android:fontFamily="@font/normalfont">

            </TextView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pick_pin"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:paddingLeft="8dp"
                    android:src="@drawable/dot"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_pickup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:background="@android:color/transparent"
                    android:drawablePadding="@dimen/dp_10"
                    android:fadingEdge="horizontal"
                    android:gravity="center_vertical"
                    android:hint="@string/picklocation"
                    android:lines="1"
                    android:fontFamily="@font/normalfont"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingTop="@dimen/taxi__search_padding_medium"
                    android:paddingEnd="@dimen/pad_15dp"
                    android:paddingBottom="@dimen/taxi__search_padding_medium"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="binding_1"                
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintcolor"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/pic_loc_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/pad_5dp"
                    android:layout_weight="0.1"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_favorite_unselect" />


            </LinearLayout>




            </LinearLayout>

        <View
            android:id="@+id/pickup_drop_Sep"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@id/pick_lay"
            android:layout_toEndOf="@+id/pickup_pinlay"
            android:background="@color/linebottom_light" />
            <LinearLayout
                android:id="@+id/drop_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/pickup_pinlay"
                android:layout_below="@+id/pickup_drop_Sep"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:weightSum="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DROP-OFF"
                    android:padding="@dimen/dp_2"
                    android:visibility="visible"
                    android:fontFamily="@font/normalfont"
                    android:textSize="12sp"
                    android:paddingStart="8dp">

                </TextView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">
                <ImageView
                    android:id="@+id/drop_pin1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:paddingStart="8dp"
                    android:src="@drawable/circle_red"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_drop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:background="@android:color/transparent"
                    android:drawablePadding="@dimen/dp_10"
                    android:fadingEdge="horizontal"
                    android:gravity="center_vertical"
                    android:hint="@string/droploc"
                    android:lines="1"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingTop="@dimen/taxi__search_padding_medium"
                    android:paddingEnd="@dimen/pad_15dp"
                    android:fontFamily="@font/normalfont"
                    android:paddingBottom="@dimen/taxi__search_padding_medium"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="binding_2"              
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintcolor"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/drop_loc_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/pad_5dp"
                    android:layout_weight="0.1"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_favorite_unselect" />

        </LinearLayout>

            </LinearLayout>
    </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/recent_item_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/searchlay"
            android:tag="binding_3"                                                          
            android:background="@android:color/white"
            android:padding="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_5">

            <TextView
                android:id="@+id/txt_location1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_5"
                android:drawablePadding="@dimen/dp_10"
                android:tag="binding_4"                                                          
                android:padding="@dimen/dp_10"
                android:singleLine="true"
                                                                          
                                                          
                app:layout_constraintEnd_toStartOf="@+id/txt_location2"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                android:fontFamily="@font/normalfont"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/recent_place_btn"
                android:elevation="@dimen/dp_12"/>


            <View
                android:id="@+id/view1"
                android:layout_width="1dp"
                android:layout_height="25dp"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txt_location2"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="invisible"/>

            <TextView
                android:id="@+id/txt_location2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:drawablePadding="@dimen/dp_10"
                android:padding="@dimen/dp_10"
                android:tag="binding_5"                                   
                                                                                                 
                android:singleLine="true"
                                                          
                app:layout_constraintEnd_toStartOf="@+id/txt_location3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/txt_location1"
                android:background="@drawable/recent_place_btn"
                android:fontFamily="@font/normalfont"
                android:elevation="@dimen/dp_12"/>

            <View
                android:id="@+id/view2"
                android:layout_width="1dp"
                android:layout_height="25dp"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txt_location3"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="invisible"/>

            <TextView
                android:id="@+id/txt_location3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:drawablePadding="@dimen/dp_10"
                android:padding="@dimen/dp_10"
                android:tag="binding_6"                                   
                                                                                                 
                android:singleLine="true"
                                                          
                android:fontFamily="@font/normalfont"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/txt_location2"
                android:background="@drawable/recent_place_btn"
                android:elevation="@dimen/dp_12"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>

         