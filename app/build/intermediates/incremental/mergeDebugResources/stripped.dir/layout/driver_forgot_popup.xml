<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inner_content"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:focusable="false"
    android:gravity="bottom"
    android:background="@color/transparent"
    android:focusableInTouchMode="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:background="@drawable/corner_over_tripdetail"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/message"
                style="@android:style/TextAppearance.Large"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/f_forgotpwd"
                android:textColor="@color/black" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1dp"
                android:background="@color/text_filed" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:layout_marginTop="@dimen/dp_15"
            android:orientation="vertical"
            >

            <TextView
                style="@android:style/TextAppearance.Medium"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:gravity="center_vertical|center_horizontal"
                android:text="@string/f_timetoreach"
                android:visibility="gone" />

            <EditText
                android:id="@+id/forgotmail"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:hint="@string/enter_your_mobile_number"
                android:maxLength="13"
                android:padding="10dp"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginEnd="@dimen/dp_15"
                android:autofillHints="@string/enter_your_mobile_number"
                tools:targetApi="o"
                android:layout_marginTop="05dp"
                android:singleLine="true"
                android:textColor="@color/block"
                android:textColorHint="@color/hintcolor" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginEnd="@dimen/dp_15"
                android:background="@color/linebottom_light" />



            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginEnd="@dimen/dp_15"
                android:layout_below="@+id/trip_detail_lay"
                android:layout_marginTop="@dimen/dp_15"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/cancelbtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:fontFamily="@font/normalfont"
                    android:gravity="center"
                    android:paddingTop="@dimen/pad_5dp"
                    android:background="@null"
                    android:textAllCaps="false"
                    android:text="@string/cancel"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/sub_heading_light" />


                <LinearLayout

                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    >

                    <Button
                        android:id="@+id/okbtn"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/button_rect"
                        android:textSize="@dimen/sp_16"
                        android:textAllCaps="false"
                        android:text="@string/ok"
                        android:fontFamily="@font/normalfont"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_15">

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>