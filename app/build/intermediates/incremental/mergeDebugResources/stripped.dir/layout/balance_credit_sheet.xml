<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/corner_over_wallet"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_8"
        android:gravity="center"
        android:paddingTop="15dp"
        android:textSize="@dimen/sp_20"
        android:text="@string/add_balance_amount"
        android:textColor="@color/edittextcolor"/>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dp_10">
        <EditText
            android:id="@+id/balEdt"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:hint="@string/enter_balance_amount"
            android:inputType="number"
            android:maxLength="20"
            android:paddingTop="15dp"
            android:paddingBottom="@dimen/dp_5"
            android:textSize="@dimen/sp_18"
            android:textColor="@color/colorFontGreyLight"
            android:textColorHint="@color/colorFontGreyLight" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/dp_5"
            android:background="@color/text_filed"
            />
    </LinearLayout>
    <View
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:background="@color/linebottom_light"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_15"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"

        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="04dp">

        <Button
            android:id="@+id/cancelbtn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_5"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center"
            android:text="@string/cancel"
            android:padding="15dp"
            android:textAllCaps="false"
            android:textColor="@color/sub_heading_light"
            android:textSize="@dimen/sp_18" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/linebottom_light"
            android:visibility="gone" />

        <Button
            android:id="@+id/okbtn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/button_rect"
            android:gravity="center"
            android:padding="15dp"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_18" />
    </LinearLayout>
</LinearLayout>