<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    android:id="@+id/outstation_trip_lay"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/base_fare"
            android:layout_margin="12dp"
            android:textColor="@color/sub_heading" />

        <TextView
            android:id="@+id/BaseFare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:layout_margin="@dimen/dp_12"
            android:textColor="@color/black" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:padding="5dp"
        android:visibility="gone">

        <TextView

            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/min_trav"
            android:textColor="@color/sub_heading" />

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black" />
    </LinearLayout>

    <include layout="@layout/normal_tripdetail_lay"
        android:visibility="gone"/>
    <include layout="@layout/outstation_tripdetail_lay"
        android:visibility="gone"/>

    <View
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:layout_margin="@dimen/dp_12"
        android:background="@color/sub_heading_light" />
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/sub_total"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/subtotal_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:id="@+id/cancelFareLayOut"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_12"
            android:layout_weight="2"
            android:text="@string/cancel_fare"
            android:textColor="@color/sub_heading" />

        <TextView
            android:id="@+id/cancelFeeVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_12"
            android:layout_weight="1"
            android:gravity="end"
            android:text="12"
            android:textColor="@color/block" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/promotion_val_lay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/promotion"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/promotion_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:layout_margin="@dimen/dp_12"
        android:background="@color/sub_heading_light" />
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/trip_cost"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/tripcost_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/Tax"
            android:id="@+id/txt_tax"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/tax_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:layout_margin="@dimen/dp_12"
        android:background="@color/sub_heading_light" />
    <LinearLayout
        android:id="@+id/evening_farelay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/even_charge"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/evefare_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:layout_margin="@dimen/dp_12"
            android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/night_farelay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/nit_fare"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/night_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/net_total"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"
            />

        <TextView
            android:id="@+id/nettotal_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/WalletAmt_lay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/wallet_amt"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/WalletAmt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/paid_amt"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/PaidAmt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="$0.00"
            android:layout_margin="@dimen/dp_12"
            android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/payment_type"
            android:textColor="@color/sub_heading"
            android:layout_margin="@dimen/dp_12"/>

        <TextView
            android:id="@+id/Paymenttype"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="cash"
            android:textColor="@color/black"
            android:layout_margin="@dimen/dp_12"/>
    </LinearLayout>

</LinearLayout>