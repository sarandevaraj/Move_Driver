<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lay_splash"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/relativelay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splashnew">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40dp"
                android:text="tmobility"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>



        <ImageView
            android:id="@+id/body_iv"
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:layout_centerInParent="true" />

        <ProgressBar
            android:id="@+id/progressBar1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_above="@+id/status_text"
            android:layout_centerInParent="true"
            android:progressDrawable="@drawable/custom_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="150dp"
            android:padding="10dp"
            android:text="@string/getting_gps"
            android:textColor="@color/black"
            android:textSize="@dimen/text_dialog_normal"
            android:visibility="gone" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/access_key_lay"
        android:paddingTop="50dp"
        android:layout_width="fill_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:padding="20dp"
            android:layout_above="@+id/get_started_lay"
            android:layout_width="fill_parent"
            android:gravity="center"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/access_logo_lay"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/access_logo"
                    android:src="@drawable/access_logo"
                    android:layout_width="200dp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_to_"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:textSize="16sp"/>

                <EditText
                    android:layout_marginTop="50dp"
                    android:layout_marginBottom="50dp"
                    android:id="@+id/access_key_text"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:background="@drawable/driver_border_edittext"
                    android:hint="@string/domain_hint"
                    android:maxLength="16"
                    android:textSize="16dp"
                    android:padding="10dp"
                    android:textColor="@color/edittextcolor"
                    android:singleLine="true"
                    android:textColorHint="@color/hintcolor" />

            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_25"
            android:layout_marginEnd="@dimen/dp_15"
            android:visibility="gone"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/spannable_terms_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginBottom="5dp"
                android:gravity="center|start"
                android:textColorHint="@color/grey_color_text"
                android:textSize="@dimen/sp_14" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/get_started_lay"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="30dp"
            android:orientation="horizontal">


            <Button
                android:id="@+id/cancelbtn"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:padding="10dp"
                android:visibility="gone"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/black" />

            <View
                android:id="@+id/for_sep"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/linebottom_light" />

            <Button
                android:id="@+id/okbtn"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:background="@color/black"
                android:gravity="center"
                android:padding="10dp"
                android:textSize="20dp"
                android:text="@string/get_started"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>