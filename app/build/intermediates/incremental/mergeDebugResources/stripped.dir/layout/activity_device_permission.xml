<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/id_privacy_parent_lay"
    android:background="@color/quantum_grey100"
    android:orientation="vertical"
    tools:context=".permission.DevicePermissionActivity">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_10"
                android:gravity="center"
                android:padding="@dimen/pad_5dp"
                android:text="@string/we_request_your_permission_for"
                android:textColor="@color/black_new"
                android:textSize="18sp"
                android:fontFamily="@font/boldfont"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:orientation="horizontal">


                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/accessLocationCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:layout_gravity="center"
                        android:background="@drawable/driver_privacy_selection_new"
                        android:checked="true" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/loc_mandatory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="start|top"
                        android:padding="@dimen/dp_5"
                        android:textStyle="bold"
                        android:text="@string/location"
                        android:textColor="@color/black_new"
                        android:textSize="18sp"
                        android:fontFamily="@font/boldfont"/>


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center|start"
                    android:textSize="@dimen/sp_14"
                    android:text="@string/privacy_location_text"
                    android:textColor="@color/grey_color_text"
                    android:fontFamily="@font/normalfont">

                </TextView>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:orientation="horizontal">


                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/readContactsCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:layout_gravity="center"
                        android:background="@drawable/driver_privacy_selection"
                        android:checked="true" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="start|top"
                        android:padding="@dimen/dp_5"
                        android:textStyle="bold"
                        android:text="@string/contacts"
                        android:textColor="@color/black_new"
                        android:textSize="18sp" />


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center|start"
                    android:textSize="@dimen/sp_14"
                    android:text="@string/privacy_contacts_text"
                    android:textColor="@color/grey_color_text">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:orientation="horizontal">


                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/readDeviceInformationCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:layout_gravity="center"
                        android:background="@drawable/driver_privacy_selection"
                        android:checked="true" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_device_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="start|top"
                        android:padding="@dimen/dp_5"
                        android:textStyle="bold"
                        android:text="@string/device_information"
                        android:textColor="@color/black_new"
                        android:textSize="18sp" />


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center|start"
                    android:textSize="@dimen/sp_14"
                    android:text="@string/privacy_device_information"
                    android:textColor="@color/grey_color_text">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:orientation="horizontal">


                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/accessCallPhoneCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:layout_gravity="center"
                        android:background="@drawable/driver_privacy_selection"
                        android:checked="true" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_call_permission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="start|top"
                        android:padding="@dimen/dp_5"
                        android:textStyle="bold"
                        android:text="@string/call_permission"
                        android:textColor="@color/black_new"
                        android:textSize="18sp" />


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center|start"
                    android:textSize="@dimen/sp_14"
                    android:text="@string/privacy_call_text"
                    android:textColor="@color/grey_color_text">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:orientation="horizontal">


                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/accessStorageCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:layout_gravity="center"
                        android:background="@drawable/driver_privacy_selection"
                        android:checked="true" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_storage_gallery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="start|top"
                        android:padding="@dimen/dp_5"
                        android:textStyle="bold"
                        android:text="@string/storage_and_gallery"
                        android:textColor="@color/black_new"
                        android:textSize="18sp"
                        android:fontFamily="@font/boldfont"/>


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center|start"
                    android:textSize="@dimen/sp_14"
                    android:text="@string/privacy_storage_gallery_text"
                    android:textColor="@color/grey_color_text"
                    android:fontFamily="@font/normalfont">

                </TextView>
            </LinearLayout>


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="42dp"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginEnd="30dp"
                android:gravity="left|center"
                android:padding="@dimen/pad_5dp"
                android:textSize="@dimen/sp_14"
                android:text="@string/change_permission_in_phone"
                android:textColor="@color/grey_color_text"
                android:fontFamily="@font/normalfont"/>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_25"
                android:orientation="horizontal"
                android:layout_height="wrap_content">


                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/termsCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    style="@style/Widget.AppCompat.CompoundButton.CheckBox"
                    android:layout_height="wrap_content" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/spannable_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/dp_15"
                    android:layout_marginBottom="5dp"
                    android:gravity="center|start"
                    android:textColorHint="@color/black_new"
                    android:textSize="@dimen/sp_14"
                    android:fontFamily="@font/normalfont"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonProceed"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="90dp"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginEnd="90dp"
                android:layout_marginBottom="@dimen/dp_8"
                android:background="@drawable/curve_shape"
                android:elevation="2dp"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/proceed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14"
                android:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storeDataView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_10"
                android:layout_marginBottom="@dimen/dp_20"
                android:gravity="center"
                android:padding="@dimen/pad_5dp"
                android:text="@string/store_data"
                android:textColor="@color/button_accept"
                android:textSize="@dimen/sp_14"
                android:fontFamily="@font/normalfont"/>


        </LinearLayout>

    </ScrollView>



</LinearLayout>