<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@+id/card_lay_bottom"
    app:cardElevation="@dimen/dp_20"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"

        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/cancel_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_weight="1"
                android:text="@string/cancel_fare"
                android:textColor="@color/black" />

            <TextView
                android:layout_weight="1.5"
                android:gravity="end"
                android:id="@+id/txt_cancel_fare"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/fare2"
                android:textColor="@color/black" />
        </LinearLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@color/linebottom_light" />
        <TextView
            android:layout_weight="1.5"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dp_15"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="@dimen/dp_20"
            android:text="@string/reson_cancel_title"
            android:textColor="@color/black" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:id="@+id/cancel_lay_view"
            android:visibility="visible"
            android:background="@color/sub_heading_light" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/lay_reason_one"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reason1"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/check1"
                        android:layout_weight=".90"
                        android:gravity="bottom"
                        android:paddingLeft="10dp"
                        android:text="@string/reason1"
                        android:textColor="@color/sub_heading" />

                    <ImageView
                        android:id="@+id/check1"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:layout_weight=".10"
                        android:padding="12dp"

                        android:src="@drawable/tick_focus" />

                </RelativeLayout>

                <View
                    android:id="@+id/line1"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/white" />

                <RelativeLayout
                    android:id="@+id/lay_reason_two"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reason2"
                        style="@style/enterTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/check2"
                        android:layout_weight=".90"
                        android:gravity="bottom"
                        android:paddingLeft="10dp"
                        android:text="@string/reason2"
                        android:textColor="@color/sub_heading" />


                    <ImageView
                        android:id="@+id/check2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:layout_weight=".10"
                        android:padding="12dp"

                        android:src="@drawable/tick_unfocus" />


                </RelativeLayout>

                <View
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/white" />

                <RelativeLayout
                    android:id="@+id/lay_reason_three"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:id="@+id/reason3"
                        style="@style/enterTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/check3"
                        android:layout_weight=".90"
                        android:gravity="bottom"
                        android:paddingLeft="10dp"
                        android:text="@string/reason3"
                        android:textColor="@color/sub_heading" />

                    <ImageView
                        android:id="@+id/check3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:layout_weight=".10"
                        android:padding="12dp"

                        android:src="@drawable/tick_unfocus" />


                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/lay_reason_four"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reason4"
                        style="@style/enterTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/check4"
                        android:layout_weight=".90"
                        android:gravity="bottom"
                        android:paddingLeft="10dp"
                        android:text="@string/reason4"
                        android:textColor="@color/sub_heading" />

                    <ImageView
                        android:id="@+id/check4"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:layout_weight=".10"
                        android:padding="12dp"

                        android:src="@drawable/tick_unfocus" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/lay_reason_five"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reason5"
                        style="@style/enterTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/check5"
                        android:layout_weight=".90"
                        android:gravity="bottom"
                        android:paddingLeft="10dp"
                        android:text="@string/reason5"
                        android:textColor="@color/sub_heading" />

                    <ImageView
                        android:id="@+id/check5"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:layout_weight=".10"
                        android:padding="12dp"

                        android:src="@drawable/tick_unfocus" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/lay_reason_six"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reason6"
                        style="@style/enterTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/check6"
                        android:layout_weight=".90"
                        android:gravity="bottom"
                        android:paddingLeft="10dp"
                        android:text="@string/reason6"
                        android:textColor="@color/sub_heading" />

                    <ImageView
                        android:id="@+id/check6"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:layout_weight=".10"
                        android:padding="12dp"

                        android:src="@drawable/tick_unfocus" />


                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/reasonotherlay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:weightSum="2">

                    <EditText
                        android:id="@+id/reasonother"
                        style="@style/enterTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:background="@drawable/rect_home_bottom"
                        android:gravity="bottom"
                        android:maxLength="150"
                        android:padding="10dp"

                        android:textColor="@color/sub_heading"
                        android:textColorHint="@color/hintcolor" />

                    <Button
                        android:id="@+id/reson_submit"
                        style="@style/enterTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="10dp"
                        android:background="@color/button_accept"
                        android:gravity="center"
                        android:text="@string/submit"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</LinearLayout>
</androidx.cardview.widget.CardView>