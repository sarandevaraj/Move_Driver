<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >



        <LinearLayout
            android:id="@+id/book_lay"

            android:layout_marginTop="@dimen/dp_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/map_image"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:orientation="vertical">

                <RelativeLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <com.taximobility.driver.utils.DriverRoundedImageView
                        android:id="@+id/driver_image"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="2dp"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/driver_loadingimage" />

                    <RelativeLayout
                        android:id="@+id/trip_time_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/driver_image"
                        android:orientation="horizontal"

                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">



                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginStart="@dimen/dp_5"
                                android:padding="@dimen/pad_5dp">

                                <TextView
                                    android:id="@+id/trip_driver_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/normalfont"
                                    android:ellipsize="end"
                                    android:text="name"
                                    android:layout_weight="1"
                                    android:textColor="@color/block"
                                    android:textSize="@dimen/dp_20"
                                    android:textStyle="bold" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="right"
                                    android:layout_marginEnd="8dp"
                                    android:text="Completed"
                                    android:layout_gravity="right"
                                    android:fontFamily="@font/normalfont"
                                    android:drawablePadding="@dimen/dp_5"
                                    android:textColor="#6dbe16"
                                    android:textSize="14sp"
                                    />


                            </LinearLayout>



<!--                            <TextView-->
<!--                                android:id="@+id/trip_driver_name"-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_below="@+id/trip_time"-->
<!--                                android:layout_marginTop="@dimen/dp_10"-->
<!--                                android:layout_toRightOf="@+id/driver_image"-->
<!--                                android:fontFamily="@font/normalfont"-->
<!--                                android:paddingLeft="5dp"-->
<!--                                android:textColor="@color/block"-->
<!--                                tools:text="Test" />-->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginStart="@dimen/dp_5"
                                android:padding="@dimen/pad_5dp">

                                <TextView
                                    android:id="@+id/total_distance_fare"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/normalfont"
                                    android:ellipsize="end"
                                    android:text="$20.00"
                                    android:textColor="@color/block"
                                    android:textSize="16dp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="0.1dp"
                                    android:layout_gravity="center"
                                    android:layout_height="@dimen/dp_15"
                                    android:layout_marginStart="@dimen/dp_15"
                                    android:background="@color/sub_heading_light"
                                    android:visibility="gone"/>

                                <TextView
                                    android:id="@+id/total_km"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="right"
                                    android:text="10.0KM"
                                    android:layout_marginStart="@dimen/dp_15"
                                    android:fontFamily="@font/normalfont"
                                    android:drawablePadding="@dimen/dp_5"
                                    android:textColor="@color/block"
                                    android:textSize="@dimen/dp_16"
                                    android:textStyle="bold"
                                    android:visibility="gone"/>


                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="@dimen/dp_4"
                                android:layout_marginStart="@dimen/dp_5"
                                android:padding="@dimen/pad_5dp">

                                <TextView
                                    android:id="@+id/model_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/normalfont"
                                    android:ellipsize="end"
                                    android:text="Taxi"
                                    android:textColor="@color/sub_heading"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:textColor="@color/sub_heading"
                                    android:layout_marginStart="@dimen/dp_5"
                                    />

                                <TextView
                                    android:id="@+id/trip_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="right"
                                    android:text="10.0KM"
                                    android:layout_marginStart="@dimen/dp_5"
                                    android:fontFamily="@font/normalfont"
                                    android:textColor="@color/sub_heading"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />


                            </LinearLayout>


                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/can_track"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"

                            android:layout_centerVertical="true"
                            android:layout_gravity="right">

                            <TextView
                                android:id="@+id/trip_track"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/driver_rect_red"
                                android:paddingLeft="5dp"
                                android:paddingTop="5dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="5dp"
                                android:text="@string/track_now"
                                android:textColor="@color/button_accept"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/trip_cancel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/driver_cancelbg"
                                android:paddingLeft="10dp"
                                android:paddingTop="5dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="5dp"
                                android:text="@string/cancel"
                                android:textColor="@color/black"
                                android:visibility="gone" />
                        </FrameLayout>

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/pick_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_below="@+id/trip_time_lay"
                        android:orientation="horizontal"
                        >

                        <ImageView
                            android:layout_width="@dimen/pad_30dp"
                            android:layout_height="@dimen/pad_30dp"
                            android:layout_gravity="center"
                            android:padding="5dp"
                            card_view:srcCompat="@drawable/ic_pickup_pin" />

                        <TextView
                            android:id="@+id/txt_pickup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:layout_marginTop="3dp"
                            android:drawablePadding="@dimen/dp_10"
                            android:fadingEdge="horizontal"
                            android:gravity="center_vertical"
                            android:hint="@string/picklocation"
                            android:lines="1"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="@string/picklocation"
                            android:textColor="@color/sub_heading"
                            android:textColorHint="@color/hintcolor"
                            android:textSize="16sp" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/pick_lay"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_marginTop="@dimen/dp_2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/pad_30dp"
                            android:layout_height="@dimen/pad_30dp"
                            android:layout_gravity="center"
                            android:padding="5dp"
                            card_view:srcCompat="@drawable/ic_drop_pin" />


                        <TextView
                            android:id="@+id/txt_drop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fadingEdge="horizontal"
                            android:gravity="center"
                            android:hint="@string/droploc"
                            android:lines="1"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="@string/droploc"
                            android:textColor="@color/sub_heading"
                            android:textColorHint="@color/hintcolor"
                            android:textSize="16sp" />
                    </LinearLayout>


                </RelativeLayout>

                <View

                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_above="@+id/con_lay"
                    android:layout_marginStart="@dimen/sp_14"
                    android:layout_marginEnd="@dimen/sp_14"
                    android:layout_marginTop="@dimen/sp_14"
                    android:background="@color/separator_line" />


            </LinearLayout>
        </LinearLayout>


</FrameLayout>





