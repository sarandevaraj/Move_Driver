<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/credit_contain"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_12"
    android:layout_marginTop="@dimen/dp_20"
    android:layout_marginRight="@dimen/dp_12"
    android:background="@drawable/corner_over_payment"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        >

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/card_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/ic_visa_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="vertical"

            />

        <TextView
            android:id="@+id/CardTxt"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginRight="10dp"
            android:fontFamily="@font/boldfont"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/dp_24"
            android:textStyle="bold"
            android:tooltipText="@string/above" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginRight="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cvv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/normalfont"
                android:text=""
                android:textColor="@color/white"
                android:textSize="14dp"
                android:textStyle="bold"
                android:tooltipText="@string/above" />


            <TextView
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/normalfont"
                android:padding="10dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="14dp"

                android:textStyle="bold"
                android:tooltipText="@string/above" />

        </LinearLayout>
    </LinearLayout>


    <ImageView
        android:id="@+id/img_lineup"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/line1"
        android:visibility="gone" />


    <ImageView
        android:id="@+id/img_linebottom"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/line2"
        android:visibility="gone" />

</LinearLayout>