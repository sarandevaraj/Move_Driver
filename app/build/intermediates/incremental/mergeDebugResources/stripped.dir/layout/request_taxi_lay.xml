<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/estimate_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mdtp_done_disabled_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/pad_15dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/pad_20dp"
            android:layout_height="20dp"
            android:layout_marginRight="@dimen/dp_10"
            android:src="@drawable/cash_b"
            app:layout_constraintBottom_toTopOf="@id/request_txt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txt_estimate_fare"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_estimate_fare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/estimate_fare"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@id/request_txt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>

    <TextView
        android:id="@+id/request_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/requestingtaxi"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/estimate_lay" />

    <com.github.ybq.android.spinkit.SpinKitView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/dotsProgressBar"
        style="@style/SpinKitView.Small.ThreeBounce"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        app:SpinKit_Color="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/request_txt"
        app:layout_constraintTop_toBottomOf="@id/estimate_lay" />


</androidx.constraintlayout.widget.ConstraintLayout>