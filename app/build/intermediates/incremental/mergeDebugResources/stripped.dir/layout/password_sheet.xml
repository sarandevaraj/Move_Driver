<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="10dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/change_psd_lbl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="10dp"
        android:paddingTop="7dp"
        android:text="@string/chpwd"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_18" />

    <View
        android:id="@+id/img_lineup"
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:background="@color/sub_heading_light" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingTop="06dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/white">


            <TextView
                android:id="@+id/hideoldpwd"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="05dp"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:padding="9dp"
                android:text="@string/show"
                android:textColor="@color/black"
                android:visibility="gone" />


            <EditText
                android:id="@+id/oldpwd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="@color/edittextcolor"
                android:layout_toLeftOf="@+id/hideoldpwd"
                android:background="@color/white"
                android:hint="@string/oldpwd"
                android:inputType="textPassword"
                android:gravity="center_vertical"
                android:maxLength="32"
                android:paddingTop="5dp"
                android:paddingBottom="@dimen/dp_5"
                android:textColorHint="@color/sub_heading"
                android:textSize="@dimen/sp_16" />

        </RelativeLayout>


        <View
            android:layout_width="fill_parent"
            android:layout_height="0.5dp"
            android:layout_marginVertical="@dimen/dp_8"
            android:background="@color/sub_heading_light" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/white">


            <TextView
                android:id="@+id/hidenewpwd"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="5dp"
                android:background="@color/white"

                android:padding="9dp"
                android:text="@string/show"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:visibility="gone" />

            <EditText
                android:id="@+id/newpwd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/hidenewpwd"
                android:textColor="@color/edittextcolor"
                android:background="@color/white"
                android:drawablePadding="20dp"
                android:hint="@string/newpwd"
                android:inputType="textPassword"
                android:maxLength="32"
                android:paddingTop="5dp"
                android:paddingBottom="@dimen/dp_5"                android:gravity="center_vertical"
                android:textColorHint="@color/sub_heading"
                android:textSize="@dimen/sp_16" />

        </RelativeLayout>


        <View
            android:layout_width="fill_parent"
            android:layout_height="0.5dp"
            android:layout_marginVertical="@dimen/dp_8"
            android:background="@color/sub_heading_light" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/white">


            <TextView
                android:id="@+id/hideconfirmpwd"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="5dp"
                android:background="@color/white"
                android:padding="9dp"
                android:text="@string/show"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:visibility="gone" />


            <EditText
                android:id="@+id/confirmpwd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/hideconfirmpwd"
                android:background="@color/white"
                android:textColor="@color/edittextcolor"
                android:drawablePadding="20dp"
                android:hint="@string/conpwd"
                android:inputType="textPassword"
                android:maxLength="32"
                android:paddingTop="5dp"
                android:paddingBottom="@dimen/dp_5"                android:gravity="center_vertical"
                android:textColorHint="@color/sub_heading"
                android:textSize="@dimen/sp_16" />

        </RelativeLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="04dp"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_5"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:visibility="gone"
                android:textSize="@dimen/sp_16" />

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/sub_heading_light" />

            <Button
                android:id="@+id/submit"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_rect"
                android:gravity="center"
                android:text="@string/submit"
                android:textStyle="bold"
                android:fontFamily="@font/normalfont"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/dp_16" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>