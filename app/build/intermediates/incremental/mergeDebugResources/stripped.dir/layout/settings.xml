<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"

    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_margin="@dimen/dp_15"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_10">

            <TextView
                android:id="@+id/CardTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:drawableRight="@drawable/arrrowright"
                android:fontFamily="@font/normalfont"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/dp_10"

                android:text="@string/Language"
                android:textColor="@color/black"
                android:textSize="@dimen/text_normal" />


        </LinearLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@color/separator_line" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/dp_10"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:background="@color/white"
                android:fontFamily="@font/normalfont"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/dp_10"

                android:text="@string/split_"
                android:textColor="@color/black"
                android:textSize="@dimen/text_normal" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/spliton_off"
                android:layout_width="50dp"
                android:layout_height="25dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:checked="true"
                android:textOff=""
                android:textOn=""
                app:theme="@style/Color1SwitchStyle" />


        </RelativeLayout>


        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="@color/separator_line" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/dp_10">

            <TextView
                android:id="@+id/favoritedriver"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:background="@color/white"
                android:drawableRight="@drawable/arrrowright"
                android:fontFamily="@font/normalfont"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/dp_10"
                android:text="@string/favoritedriver_"
                android:textColor="@color/black"
                android:textSize="@dimen/text_normal" />

            <CheckBox
                android:id="@+id/favoritedriverson_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/off_btn"
                android:button="@null"
                android:checked="true"
                android:textOff=""
                android:textOn=""
                android:visibility="gone"
                app:theme="@style/Color1SwitchStyle" />


        </RelativeLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="@color/separator_line"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="@dimen/dp_10"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:background="@color/white"
                android:padding="10dp"
                android:text="@string/skip_fav"
                android:textColor="@color/black"
                android:textSize="@dimen/text_normal" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/skip_drop_on_off"
                android:layout_width="50dp"
                android:layout_height="25dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:checked="true"
                android:textOff=""
                android:textOn=""
                app:theme="@style/Color1SwitchStyle" />


        </RelativeLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="@color/separator_line" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/dp_10">

            <TextView
                android:id="@+id/txt_privacy_policy"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:background="@color/white"
                android:drawableRight="@drawable/arrrowright"
                android:fontFamily="@font/normalfont"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/dp_10"
                android:text="@string/privacy_settings"
                android:textColor="@color/black"
                android:textSize="@dimen/text_normal" />
        </RelativeLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="@color/separator_line" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/dp_10">

            <TextView
                android:id="@+id/logout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:background="@color/white"
                android:fontFamily="@font/normalfont"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/dp_10"

                android:text="@string/m_logout"
                android:textColor="@color/black"
                android:textSize="@dimen/text_normal" />


        </RelativeLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="@color/separator_line" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/baseUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:fontFamily="@font/normalfont"
                android:padding="10dp"

                android:text="skjdfkjhj"
                android:textColor="@color/button_accept" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:fontFamily="@font/normalfont"
                android:padding="10dp"

                android:textColor="@color/textviewcolor_light" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>