<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="5dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        card_view:cardCornerRadius="4dp"
        card_view:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/map_image"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="fitXY"
                tools:src="@drawable/splashnew" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:gravity="center_vertical">

                    <com.taximobility.util.RoundedImageView
                        android:id="@+id/driver_image"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="5dp"
                        android:src="@drawable/ic_launcher" />

                    <TextView
                        android:id="@+id/trip_time"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/driver_image"
                        android:gravity="right"
                        android:paddingTop="5dp"
                        android:textColor="@color/black"
                        tools:text="sunn" />

                    <TextView
                        android:id="@+id/trip_driver_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/trip_time"
                        android:layout_toEndOf="@+id/driver_image"
                        android:padding="5dp"
                        android:textColor="@color/textviewcolor_dark"
                        tools:text="ddfsfs" />

                    <TextView
                        android:id="@+id/trip_payment_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="@dimen/dp_5"
                        android:text="@string/cash"
                        android:textAllCaps="true"
                        android:textColor="@color/pastbookingcashtext"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/trip_payment_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/trip_payment_type"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="5dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/black"
                        tools:text="$25.00" />

                    <TextView
                        android:id="@+id/trip_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/trip_payment_amount"
                        android:layout_alignParentEnd="true"
                        android:paddingStart="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="@string/completed"
                        android:textColor="@color/textviewcolor_dark" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>