        <TextView
            android:id="@+id/wallet_history"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/check"
            android:paddingBottom="5dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:layout_alignParentLeft="true"
            android:text="@string/invite_sharevia"
            android:textColor="@color/blue"
            android:textSize="16sp" />

        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/wallet_history"
            android:layout_below="@+id/shareVia"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="2dp">


                <TextView
                    android:id="@+id/ifacebookTxt"

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:drawablePadding="10dp"
                    android:drawableRight="@drawable/driver_invite_fb"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/invite_fb"
                    android:textColor="@color/textviewcolor_light" />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="#cccccc" />

                <TextView
                    android:id="@+id/itwitterTxt"

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:drawablePadding="10dp"
                    android:drawableRight="@drawable/driver_invite_twitter"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/invite_twitter"
                    android:textColor="@color/textviewcolor_light" />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="#cccccc" />

                <TextView
                    android:id="@+id/iemailTxt"

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:drawablePadding="10dp"
                    android:drawableRight="@drawable/driver_invite_email"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/invite_email"
                    android:textColor="@color/textviewcolor_light" />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="#cccccc" />

                <TextView
                    android:id="@+id/iwhatsappTxt"

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:drawablePadding="10dp"
                    android:drawableRight="@drawable/driver_invite_whatsapp"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/invite_whatsapp"
                    android:textColor="@color/textviewcolor_light" />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dp"
                    android:background="#cccccc" />

                <TextView
                    android:id="@+id/ismsTxt"

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:drawablePadding="10dp"
                    android:drawableRight="@drawable/driver_invite_sms"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/invite_sms"
                    android:textColor="@color/textviewcolor_light" />


            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/shareVia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="25dp"
            android:background="@color/button_accept"
            android:drawablePadding="10dp"
            android:drawableRight="@drawable/driver_share_common_ar"
            android:gravity="center|center_vertical"
            android:paddingBottom="05dp"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"
            android:paddingTop="5dp"
            android:text="@string/btn_share_invite"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/invite_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/giff"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:visibility="visible" />
        </LinearLayout>
    </RelativeLayout>


</LinearLayout>