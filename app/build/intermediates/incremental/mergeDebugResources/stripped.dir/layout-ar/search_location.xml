          layout="@layout/pickup_drop"
          bind:myViewModel="@{myViewModel}" />-->


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" android:tag="layout-ar/search_location_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bind="http://schemas.android.com/apk/res-auto">

        <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:id="@+id/pickup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:tag="binding_1"                                                          
            android:layout_marginEnd="@dimen/dp_12"
            android:background="@color/white"
            card_view:cardCornerRadius="0dp"
            card_view:cardElevation="@dimen/dp_5">

            <LinearLayout
                android:id="@+id/pick_lay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/pickup_pinlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="1">

                <ImageView
                    android:id="@+id/pick_pin"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:paddingRight="8dp"
                    android:src="@drawable/dot"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/txt_pickup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:background="@android:color/transparent"
                    android:drawablePadding="@dimen/dp_10"
                    android:fadingEdge="horizontal"
                    android:gravity="center_vertical"
                    android:hint="@string/picklocation"
                    android:lines="1"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingTop="@dimen/taxi__search_padding_medium"
                    android:paddingEnd="@dimen/pad_15dp"
                    android:paddingBottom="@dimen/taxi__search_padding_medium"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="binding_2"                
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintcolor"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/pic_loc_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/pad_5dp"
                    android:layout_weight="0.1"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_favorite_unselect" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:id="@+id/drop_card"
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pickup_card"
            android:tag="binding_3"                                                        
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            card_view:cardCornerRadius="0dp">

            <LinearLayout
                android:id="@+id/drop_lay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/pickup_pinlay"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="1">
                <ImageView
                    android:id="@+id/drop_pin"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:paddingStart="8dp"
                    android:src="@drawable/circle_red"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/txt_drop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:background="@android:color/transparent"
                    android:drawablePadding="@dimen/dp_10"
                    android:fadingEdge="horizontal"
                    android:gravity="center_vertical"
                    android:hint="@string/droploc"
                    android:lines="1"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingTop="@dimen/taxi__search_padding_medium"
                    android:paddingEnd="@dimen/pad_15dp"
                    android:paddingBottom="@dimen/taxi__search_padding_medium"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="binding_4"              
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintcolor"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/drop_loc_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/pad_5dp"
                    android:layout_weight="0.1"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_favorite_unselect" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/recent_item_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/drop_card"
            android:tag="binding_5"                                                          
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            android:background="@android:color/white"
            android:padding="@dimen/dp_10">

            <TextView
                android:id="@+id/txt_location1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_5"
                android:drawableStart="@drawable/search"
                android:drawablePadding="@dimen/dp_10"
                android:tag="binding_6"                                                          
                android:padding="@dimen/dp_10"
                android:singleLine="true"
                                                                          
                                                          
                app:layout_constraintEnd_toStartOf="@+id/txt_location2"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <View
                android:id="@+id/view1"
                android:layout_width="1dp"
                android:layout_height="25dp"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txt_location2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_location2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:drawableStart="@drawable/search"
                android:drawablePadding="@dimen/dp_10"
                android:padding="@dimen/dp_10"
                android:tag="binding_7"                                   
                                                                                                 
                android:singleLine="true"
                                                          
                app:layout_constraintEnd_toStartOf="@+id/txt_location3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/txt_location1" />

            <View
                android:id="@+id/view2"
                android:layout_width="1dp"
                android:layout_height="25dp"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txt_location3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_location3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:drawableStart="@drawable/search"
                android:drawablePadding="@dimen/dp_10"
                android:padding="@dimen/dp_10"
                android:tag="binding_8"                                   
                                                                                                 
                android:singleLine="true"
                                                          
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/txt_location2" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>

         