<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signinlayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/appbg"
    android:focusableInTouchMode="false"
    android:orientation="vertical">

    <include
        layout="@layout/driver_include_headler"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar" />

    <FrameLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_below="@+id/slide_lay"
        android:foreground="@drawable/driver_background_shadow"
        android:visibility="visible">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>


    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center|bottom"

        android:background="@color/appbg">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/appbg"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/dp_2"
            android:layout_above="@+id/t_c_web_txt">

            <ImageView
                android:id="@+id/imageview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                android:layout_marginTop="100dp" />


            <EditText
                android:id="@+id/phoneEdt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginTop="@dimen/dp_40"
                android:background="@color/appbg"
                android:layout_below="@+id/imageview"
                android:drawablePadding="5dp"
                android:drawableRight="@drawable/driver_mobileno"
                android:gravity="right"
                android:hint="@string/phone"
                android:inputType="number"
                android:maxLength="13"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/textviewcolor_dark"
                android:textColorHint="@color/hintcolor" />

            <View
                android:id="@+id/viewborder"
                android:layout_width="fill_parent"
                android:layout_below="@+id/phoneEdt"
                android:layout_height="0.5dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/bordercolor" />

            <RelativeLayout
                android:id="@+id/passwordlay"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewborder"
                android:background="@color/appbg">


                <TextView
                    android:id="@+id/hidePwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="5dp"
                    android:background="@color/appbg"
                    android:padding="9dp"
                    android:text="@string/show"
                    android:textColor="@color/block"
                    android:visibility="gone" />


                <EditText
                    android:id="@+id/passwordEdt"

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_toRightOf="@+id/hidePwd"
                    android:background="@color/appbg"
                    android:drawablePadding="5dp"
                    android:drawableRight="@drawable/driver_password"
                    android:gravity="right"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:maxLength="32"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/textviewcolor_dark"
                    android:textColorHint="@color/hintcolor" />
            </RelativeLayout>

            <View
                android:id="@+id/viewborderdown"
                android:layout_below="@+id/passwordlay"
                android:layout_width="fill_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/bordercolor" />
            <TextView
                android:layout_below="@+id/viewborderdown"
                android:id="@+id/signup_web"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/forgotpswdTxt"
                android:layout_gravity="right|center_vertical"
                android:layout_marginLeft="10dp"
                android:gravity="right"
                android:text="@string/signup"
                android:textColor="@color/textviewcolor_dark"
                android:textColorHint="@color/hintcolor"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/forgotpswdTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_below="@+id/viewborderdown"
                android:layout_gravity="left|center_vertical"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:gravity="left"
                android:text="@string/forgotpswd"
                android:textColor="@color/textviewcolor_dark"
                android:textColorHint="@color/hintcolor"
                android:textSize="18sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/t_c_web_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/doneBtn1"
            android:layout_alignParentRight="true"
            android:layout_gravity="right|center_vertical"
            android:layout_marginBottom="5dp"
            android:layout_marginLeft="2dp"
            android:visibility="gone"
            android:text="@string/terms_condition"
            android:textColorHint="@color/hintcolor" />

        <TextView
            android:id="@+id/doneBtn1"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/tool_bar_bottom"
            android:layout_alignParentBottom="true"
            android:background="@color/button_accept"

            android:gravity="center"
            android:padding="10dp"
            android:text="@string/s_signin"
            android:textColor="@drawable/driver_text_color_black_to_white" />


    </RelativeLayout>


</LinearLayout>