<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/outstation_fare_layout">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right">

                <TextView
                    android:id="@+id/tv_startTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:hint="@string/f_float"
                    android:textColor="@color/textviewcolor_light"
                    android:inputType="none"
                    android:maxLength="32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:paddingRight="5dp"
                    android:textColor="@color/textviewcolor_light"
                    android:text="@string/f_km"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/textviewcolor_light"
            android:gravity="center_vertical"
            android:text="@string/Colon" />
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:textColor="@color/textviewcolor_light"
            android:gravity="right"
            android:padding="5dp"
            android:text="@string/start_time" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right">

                <TextView
                    android:id="@+id/tv_dropTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:hint="@string/f_float"
                    android:textColor="@color/textviewcolor_light"
                    android:inputType="none"
                    android:maxLength="32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:paddingRight="5dp"
                    android:textColor="@color/textviewcolor_light"
                    android:text="@string/f_km"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/textviewcolor_light"
            android:gravity="center_vertical"
            android:text="@string/Colon" />
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:textColor="@color/textviewcolor_light"
            android:gravity="right"
            android:padding="5dp"
            android:text="@string/drop_time" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/minutes_lay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:layout_gravity="clip_vertical|right"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/ed_time_mins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|right"
                    android:padding="5dp"
                    android:textColor="@color/textviewcolor_light"
                    android:hint="55"
                    android:inputType="number"
                    android:maxLines="1"
                    android:maxLength="2"
                    android:visibility="visible"
                    android:layout_weight="1"
                    android:layout_marginRight="5dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/driver_border_edittext"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:hint=":"
                    android:textColor="@color/textviewcolor_light"
                    android:inputType="none"
                    android:maxLength="2"
                    />
                <EditText
                    android:id="@+id/ed_time_hour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|right"
                    android:hint="01"
                    android:textColor="@color/textviewcolor_light"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1"
                    android:padding="5dp"
                    android:background="@drawable/driver_border_edittext"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/textviewcolor_light"
            android:gravity="center_vertical"
            android:text="@string/Colon" />
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:textColor="@color/textviewcolor_light"
            android:gravity="right"
            android:padding="5dp"
            android:text="@string/total_travel_time" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/distance_lay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right">

                <TextView
                    android:id="@+id/os_metricTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingRight="5dp"
                    android:text="@string/f_km"
                    android:textColor="@color/textviewcolor_light"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/ed_total_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|right"
                    android:hint="@string/f_float"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:maxLength="8"
                    android:padding="5dp"
                    android:textColor="@color/textviewcolor_light"
                    android:background="@drawable/driver_border_edittext"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/textviewcolor_light"
            android:gravity="center_vertical"
            android:text="@string/Colon" />

        <TextView
            android:id="@+id/tv_total_distance"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:textColor="@color/textviewcolor_light"
            android:gravity="right"
            android:padding="5dp"
            android:text="@string/total_distance" />
    </LinearLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:background="#cccccc"
        android:visibility="gone" />


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#f7f5f6"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right">
                <EditText
                    android:id="@+id/ed_trip_fare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textviewcolor_light"
                    android:gravity="center_vertical|right"
                    android:hint="@string/zero"
                    android:inputType="number"
                    android:maxLength="8"
                    android:maxLines="1"
                    android:padding="5dp"
                    android:digits="0123456789."
                    android:background="@drawable/driver_border_edittext"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/textviewcolor_light"
            android:gravity="center_vertical"
            android:text="@string/Colon" />
        <TextView
            android:id="@+id/tv_trip_fare"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:padding="5dp"
            android:gravity="right"
            android:textColor="@color/textviewcolor_light"
            android:text="@string/trip_fare" />
    </LinearLayout>

</LinearLayout>