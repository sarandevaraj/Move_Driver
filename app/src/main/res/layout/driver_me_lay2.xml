<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/me_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/button_accept"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:layout_alignParentTop="true"
        android:padding="13dp"
        tools:background="@color/button_accept">


        <ImageView
            android:id="@+id/slideImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:drawablePadding="5dp"
            android:padding="5dp"
            app:srcCompat="@drawable/ic_back_white"
            android:textSize="16sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/headerTxt"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="@string/profile"
            android:textAllCaps="false"
            android:textColor="@color/white"

           />

<!--        <TextView-->
<!--            android:id="@+id/donebtn"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_alignParentRight="true"-->
<!--            android:layout_centerVertical="true"-->
<!--            android:layout_marginRight="10dp"-->
<!--            android:background="@color/black"-->
<!--            android:paddingLeft="10dp"-->
<!--            android:paddingTop="05dp"-->
<!--            android:paddingRight="10dp"-->
<!--            android:paddingBottom="05dp"-->
<!--            android:text="@string/save"-->
<!--            android:visibility="visible"-->
<!--            android:textColor="@color/white" />-->

        <ImageView
            android:id="@+id/logout_img"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:visibility="gone"
            android:layout_alignParentRight="true"
            app:srcCompat="@drawable/ic_logout_profile"
           />

        <TextView
            android:id="@+id/btnlogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:background="@color/black"
            android:paddingLeft="10dp"
            android:paddingTop="05dp"
            android:paddingRight="10dp"
            android:paddingBottom="05dp"
            android:text="@string/m_logout"
            android:textColor="@color/white"
            android:visibility="gone" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_20"
        android:layout_below="@+id/slide_lay"
        android:foreground="@color/button_accept"
        android:visibility="visible">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>

    <ScrollView
        android:id="@+id/profile_lay_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/shadow"
        android:background="@color/white"
        android:scrollbars="vertical"
        android:scrollbarStyle="insideOverlay"
        tools:context=".MainActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/view_header"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/button_accept"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/layout_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                   >

                    <LinearLayout
                        android:id="@+id/personal_details_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/white_corner_profile"
                        android:orientation="vertical"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/driverRat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center"
                            android:layout_marginTop="45dp"
                            android:drawableLeft="@drawable/google_ic_rating"
                            android:gravity="center"
                            android:padding="@dimen/dp_8"
                            android:text="4.0"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/emergency_contact_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center"
                            android:drawableLeft="@drawable/driver_ic_sos"
                            android:drawablePadding="@dimen/dp_5"
                            android:gravity="center"
                            android:padding="@dimen/dp_5"
                            android:visibility="gone"
                            android:text="Emergency contact"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/txt_mobile_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center"
                            android:drawableLeft="@drawable/driver_ic_sos"
                            android:drawablePadding="@dimen/dp_5"
                            android:gravity="center"
                            android:padding="@dimen/dp_5"
                            android:text="Mobile settings     "
                            android:textColor="@color/black"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/btnupload"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/driver_back_green_to_white"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="@string/file_upload"
                            android:textColor="@drawable/driver_text_color_black_to_white"
                            android:textSize="8pt"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp_5"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/firstTxt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:gravity="center_vertical"
                                android:hint="First Name"
                                android:inputType="textEmailAddress"
                                android:maxLength="32"
                                android:padding="14dp"
                                android:singleLine="true"
                                android:textColorHint="@color/hintcolor"
                                android:textColor="@color/black"
                                android:textSize="@dimen/sp_14" />

                            <View
                                android:layout_width="fill_parent"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:layout_height="1dp"
                                android:background="@color/text_filed" />

                            <EditText
                                android:id="@+id/lastTxt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:gravity="center_vertical"
                                android:hint="Last Name"
                                android:maxLength="32"
                                android:textColorHint="@color/hintcolor"
                                android:padding="14dp"
                                android:singleLine="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/sp_14" />

                            <View
                                android:layout_width="fill_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:background="@color/text_filed" />

                            <EditText
                                android:id="@+id/emailEdt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@color/white"
                                android:drawablePadding="8dp"
                                android:hint="Email"
                                android:textColorHint="@color/hintcolor"
                                android:inputType="textEmailAddress"
                                android:padding="14dp"
                                android:singleLine="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/sp_14" />

                            <View
                                android:layout_width="fill_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:background="@color/text_filed" />

                            <EditText
                                android:id="@+id/mobileEdt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@color/white"
                                android:hint="Phone Number"
                                android:textColorHint="@color/hintcolor"
                                android:inputType="text"
                                android:maxLength="16"
                                android:padding="14dp"
                                android:singleLine="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/sp_14" />

                            <View
                                android:layout_width="fill_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:background="@color/text_filed" />

                            <RelativeLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/appbg">

                                <TextView
                                    android:id="@+id/hidePwd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="5dp"
                                    android:background="@color/appbg"
                                    android:padding="9dp"
                                    android:text="@string/show"
                                    android:textColor="@color/block"
                                    android:visibility="gone" />

                                <EditText
                                    android:id="@+id/passwordEdt"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toLeftOf="@+id/hidePwd"
                                    android:layout_weight="1"
                                    android:background="@color/white"
                                    android:drawablePadding="8dp"
                                    android:hint="Password"
                                    android:textColorHint="@color/hintcolor"
                                    android:inputType="textPassword"
                                    android:maxLength="32"
                                    android:padding="14dp"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/sp_14" />
                            </RelativeLayout>


                            <View
                                android:layout_width="fill_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:background="@color/text_filed" />


                            <RelativeLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/appbg">

                                <TextView
                                    android:id="@+id/hideconPwd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="5dp"
                                    android:background="@color/appbg"
                                    android:padding="9dp"
                                    android:text="@string/show"
                                    android:textColor="@color/block"
                                    android:visibility="gone" />


                                <EditText
                                    android:id="@+id/confirmpswdEdt"
                                    android:layout_width="fill_parent"
                                    android:layout_height="match_parent"
                                    android:layout_toLeftOf="@+id/hideconPwd"
                                    android:layout_weight="1"
                                    android:background="@color/white"
                                    android:hint="Confirm Password"
                                    android:inputType="textPassword"
                                    android:textColorHint="@color/hintcolor"
                                    android:maxLength="32"
                                    android:padding="10dp"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/sp_14" />



                            </RelativeLayout>

                            <Button
                                android:id="@+id/donebtn"
                                android:text="@string/save"
                                android:textColor="@color/white"
                                android:background="@drawable/button_rect"
                                android:textAllCaps="false"
                                android:layout_marginTop="@dimen/dp_10"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:layout_width="match_parent"
                                android:fontFamily="@font/normalfont"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold"
                                android:layout_height="wrap_content"/>

                            <LinearLayout
                                android:layout_marginTop="@dimen/dp_12"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/emergency_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        android:background="@drawable/white_corner_profile"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/personal_details_lay">


                        <TextView
                            android:id="@+id/btnadd_emergency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp_5"
                            android:background="@color/white"
                            android:padding="14dp"
                            android:text="@string/emergency_contact"
                            android:gravity="center_vertical"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp_14"
                            app:drawableRightCompat="@drawable/google_ic_right_small"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginTop="@dimen/dp_8"
                        android:id="@+id/privacy_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/white_corner_profile"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/emergency_lay">


                    <TextView
                        android:id="@+id/btntaxidetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp_5"
                        android:background="@color/white"
                        android:padding="14dp"
                        android:text="@string/taxi_detailsu"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_14"
                        app:drawableRightCompat="@drawable/google_ic_right_small"
                        />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        android:background="@drawable/white_corner_profile"
                        android:elevation="@dimen/dp_10"
                        android:visibility="gone"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/personal_details_lay">

                        <TextView
                            android:id="@+id/bt_privacysettings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_margin="@dimen/dp_5"
                            android:background="@color/white"
                            android:gravity="left"
                            android:padding="14dp"
                            android:text="Privacy Settings"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp_14"
                            android:visibility="visible"
                            app:drawableRightCompat="@drawable/right_arrow" />

                        <View
                            android:layout_width="fill_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/dp_15"
                            android:layout_marginEnd="@dimen/dp_15"
                            android:background="@color/text_filed" />



                        <View
                            android:layout_width="fill_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/dp_15"
                            android:layout_marginEnd="@dimen/dp_15"
                            android:background="@color/text_filed" />

                        <TextView
                            android:id="@+id/sos_txt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp_5"
                            android:background="@color/white"
                            android:padding="14dp"
                            android:text="SOS"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp_14"
                            app:drawableRightCompat="@drawable/right_arrow" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/privacy_lay">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/subscription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="gone"
                            android:layout_marginEnd="@dimen/dp_5"
                            android:fontFamily="@font/normalfont"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold"
                            android:background="@drawable/white_corner_profile"
                            android:text="@string/subscription"
                            android:textAllCaps="false" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/invitefriends_bottom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/button_rect"
                            android:text="@string/invite_friend"
                            android:textAllCaps="false"
                            android:fontFamily="@font/normalfont"
                            android:textStyle="bold"
                            android:textSize="@dimen/sp_16"
                            android:textColor="@color/white" />




                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>



            <com.movedriverdriver.driver.utils.DriverRoundedImageView
                android:id="@+id/profile_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="12dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toTopOf="@+id/layout_profile"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/layout_profile"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/loadingimage" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>
</RelativeLayout>