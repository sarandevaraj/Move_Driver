<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/carlayout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center"
    android:layout_marginBottom="05dp"
    android:layout_marginLeft="05dp"
    android:layout_marginRight="05dp"
    android:theme="@style/Mymaterialact"
    android:orientation="vertical"
    android:visibility="visible">

    <androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="410dp"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/design_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            app:behavior_hideable="false"
            app:behavior_peekHeight="200dp"
            app:elevation="4dp"
            app:layout_behavior="@string/bottom_sheet_behavior">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/new_ride"
                    android:text="@string/newride"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/new_radius_btn_background"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:layout_centerHorizontal="true"
                    android:layout_width="150dp"
                    android:fontFamily="@font/normalfont"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mov_cur_loc"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginRight="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_25"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/driver_current_loc"
                    app:backgroundTint="@android:color/white"
                    app:fabCustomSize="45dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/trip_detailslay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="03dp"
                android:orientation="vertical"
                android:visibility="visible"
                app:layout_behavior="@string/bottom_sheet_behavior">

                <LinearLayout
                    android:id="@+id/firstlay"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/driver_border_bg"
                    android:orientation="vertical"
                    android:padding="2dp">


                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="60dp"
                        android:background="@color/white">

                        <TextView
                            android:id="@+id/lasttrip_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_toLeftOf="@+id/trip_history_header"
                            android:padding="6dp"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp_16" />


                        <TextView
                            android:id="@+id/trip_history_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:gravity="right"
                            android:paddingRight="10dp"
                            android:paddingBottom="6dp"
                            android:paddingTop="2dp"
                            android:text="@string/up_coming"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp_16" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="1dp"
                            android:layout_alignParentRight="true"
                            android:layout_below="@+id/trip_history_header"
                            android:layout_marginRight="10dp"
                            android:background="@color/black" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="1dp"
                            android:layout_below="@+id/lasttrip_header"
                            android:layout_marginLeft="10dp"
                            android:background="@color/black" />


                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="70dp"
                        android:background="@color/white">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="05dp"
                            android:layout_weight=".18"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/first_tripdate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:paddingLeft="10dp"
                                android:singleLine="true"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />


                            <TextView
                                android:id="@+id/first_tripmodel"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"

                                android:paddingLeft="10dp"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp"

                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".11"
                            android:orientation="vertical"

                            >

                            <TextView
                                android:id="@+id/first_tripamt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:text=""
                                android:layout_marginRight="8dp"
                                 android:paddingTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="22sp" />


                            <TextView
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:paddingBottom="10dp"
                                android:paddingRight="10dp"
                                android:text="@string/trip_Amount"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/second_lay"
                    android:layout_width="fill_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="06dp"
                    android:layout_marginTop="06dp"
                    android:background="@drawable/driver_border_bg"
                    android:padding="2dp">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="70dp"
                        android:background="@color/white">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="05dp"
                            android:layout_marginTop="13dp"
                            android:layout_weight=".18"
                            android:orientation="vertical"

                            >

                            <TextView
                                android:id="@+id/second_tripdate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingLeft="10dp"
                                android:singleLine="true"
                                android:text="Last Trip"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />


                            <TextView
                                android:id="@+id/second_tripmodel"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:paddingLeft="10dp"
                                android:text="@string/trip_history"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".11"
                            android:orientation="vertical"

                            >

                            <TextView
                                android:id="@+id/second_tripamt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:text=""
                                android:layout_marginRight="10dp"
                                android:paddingTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="22sp" />


                            <TextView
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:paddingBottom="05dp"
                                android:paddingRight="10dp"
                                android:text="@string/trip_Amount"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/third_lay"
                    android:layout_width="fill_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="06dp"
                    android:background="@drawable/driver_border_bg"
                    android:padding="2dp">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="70dp"
                        android:background="@color/white">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="05dp"
                            android:layout_marginTop="13dp"
                            android:layout_weight=".18"
                            android:orientation="vertical"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/third_tripdate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingLeft="10dp"
                                android:singleLine="true"
                                android:text="Last Trip"
                                android:textColor="@color/textviewcolor_light"

                                android:textSize="13sp" />


                            <TextView
                                android:id="@+id/third_tripmodel"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:paddingLeft="10dp"
                                android:text="@string/trip_history"
                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".11"
                            android:orientation="vertical"

                            >

                            <TextView
                                android:id="@+id/third_tripamt"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:text=""
                                android:layout_marginRight="10dp"
                                android:paddingTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="22sp" />


                            <TextView
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:gravity="right"
                                android:paddingBottom="10dp"
                                android:paddingRight="10dp"
                                android:text="@string/trip_Amount"

                                android:textColor="@color/textviewcolor_light"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>


</LinearLayout>


