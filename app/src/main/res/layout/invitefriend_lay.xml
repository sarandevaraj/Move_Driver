<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootlay"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        >

        <include

            layout="@layout/include_headler"
            android:layout_width="fill_parent"
            android:visibility="gone"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/button_accept" />

            <LinearLayout
                xmlns:card_view="http://schemas.android.com/apk/res-auto"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_25"
                android:layout_marginRight="@dimen/dp_15"
                android:orientation="vertical"

              >

                <LinearLayout
                    android:id="@+id/invite_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_gravity="center"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/giff"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_marginBottom="@dimen/dp_15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/transparent"
                        android:id="@+id/invite_main"

                        android:orientation="horizontal">

                        <com.taximobility.util.RoundedImageView
                            android:id="@+id/profileImg"
                            android:layout_width="80dp"
                            android:layout_height="80dp"

                            android:layout_marginRight="10dp"
                            android:layout_marginTop="@dimen/dp_10"
                            android:layout_marginBottom="@dimen/dp_10"
                            android:scaleType="centerCrop"
                            android:src="@drawable/profile_image" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/referalamtTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="30sp"
                                android:text="0"
                                android:fontFamily="@font/boldfont"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/invite_youearn"
                                android:textStyle="bold"

                                android:textColor="@color/white"
                                android:textSize="13sp" />


                        </LinearLayout>


                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="6dp"
                        android:layout_marginTop="3dp"
                        android:background="@color/invite_gray" />



                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:id="@+id/txtReferralMsg"
                        android:layout_marginBottom="@dimen/dp_3"
                        android:text="@string/invite_frdrides"
                        android:textColor="@color/white"
                        android:padding="@dimen/dp_10"
                        android:textSize="14sp" />


                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/nested_scrollview"
                        android:layout_width="match_parent"

                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/bottom_lay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/white_corner_bg"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"

                                    >

                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"

                                        android:gravity="center_vertical">




                                        <LinearLayout
                                            android:layout_width="fill_parent"
                                            android:layout_height="60dp"
                                            android:gravity="center_vertical"
                                            android:background="@drawable/draw_edittext_bg"
                                            android:orientation="horizontal"
                                            android:padding="10dp">





                                            <TextView
                                                android:id="@+id/referalcdeTxt"
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:gravity="center"
                                                android:text="----"
                                                android:textColor="@color/block"
                                                android:textSize="20sp"
                                                android:textStyle="bold" />
                                            <!--android:textColor="@color/textviewcolor_dark"-->
                                        </LinearLayout>



                                    </RelativeLayout>



                                </LinearLayout>



                            </LinearLayout>



                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </LinearLayout>



        </FrameLayout>
        <TextView
            android:id="@+id/request_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="25dp"
            android:background="@drawable/button_gray"
            android:drawableLeft="@drawable/ic_share_new"
            android:drawablePadding="10dp"
            android:layout_gravity="center"
            android:gravity="center|center_vertical"
            android:paddingBottom="15dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="15dp"
            android:fontFamily="@font/normalfont"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="30dp"
            android:text="Share"
            android:textColor="@color/black" />


        <LinearLayout
            android:id="@+id/detaillay"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"

            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/button_accept"
                android:gravity="center_vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:text="@string/invite_sharevia"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/ifacebookTxt"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_bgcolor"
                android:drawableLeft="@drawable/invite_fb"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:text="@string/invite_fb"
                android:textColor="@color/black" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="0.5dp"
                android:background="@color/linebottom_light" />

            <TextView
                android:id="@+id/itwitterTxt"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_bgcolor"
                android:drawableLeft="@drawable/invite_twitter"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:text="@string/invite_twitter"
                android:textColor="@color/black" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="0.5dp"
                android:background="@color/linebottom_light" />

            <TextView
                android:id="@+id/iemailTxt"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_bgcolor"
                android:drawableLeft="@drawable/invite_email"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:text="@string/invite_email"
                android:textColor="@color/black" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="0.5dp"
                android:background="@color/linebottom_light" />

            <TextView
                android:id="@+id/iwhatsappTxt"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_bgcolor"
                android:drawableLeft="@drawable/invite_whatsapp"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:text="@string/invite_whatsapp"
                android:textColor="@color/black" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="0.5dp"
                android:background="@color/linebottom_light" />

            <TextView
                android:id="@+id/ismsTxt"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_bgcolor"
                android:drawableLeft="@drawable/invite_sms"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:text="@string/invite_sms"
                android:textColor="@color/black" />
        </LinearLayout>

    </LinearLayout>



</FrameLayout>