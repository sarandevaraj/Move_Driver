<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background="@color/appbg"
    android:orientation="vertical">




    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/actionbar"
            android:layout_weight="1"
            android:background="@color/black"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/txt_up_coming"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/new_trips"

                android:fontFamily="@font/normalfont"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <View
                android:id="@+id/upcoming_underline"
                android:layout_height="2.5dp"
                android:layout_width="fill_parent"
                android:background="@color/white" />

            </LinearLayout>

        <View
            android:layout_width="0.5dp"
            android:layout_height="fill_parent"
            android:background="@color/black" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/actionbar"
            android:layout_weight="1"
            android:background="@color/black"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/txt_past_booking"
                style="@style/enterTxt"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/past_trips"
                android:textColor="@color/textviewcolor_light"
                android:fontFamily="@font/normalfont"
                android:textAllCaps="false" />

            <View
                android:id="@+id/past_underline"
                android:layout_height="2.5dp"
                android:layout_width="fill_parent"
                android:background="@color/black" />

        </LinearLayout>

    </LinearLayout>


    <TextView
        android:id="@+id/nodataTxt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="@string/no_going_trip"
        android:textColor="@color/black"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>


