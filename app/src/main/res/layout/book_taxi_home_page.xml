<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="myBookViewModel"
            type="com.taximobility.bookingmodule.BookTaxiHomeViewModel" />
    </data>


    <RelativeLayout
        android:id="@+id/lay_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <include
            android:id="@+id/mapPageLay"
            layout="@layout/book_taxi_map_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navi_icon_book"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="5dp"
            app:srcCompat="@drawable/ic_menu" />

        <LinearLayout
            android:id="@+id/instruction_header_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/navi_icon_book"
            android:layout_gravity="center"
            android:layout_toEndOf="@+id/navi_icon_book"
            android:gravity="center_horizontal|center_vertical">


            <TextView
                android:id="@+id/instruction_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="10dp"
                android:background="#424242"
                android:gravity="center"
                android:paddingLeft="30dp"
                android:paddingTop="10dp"
                android:paddingRight="30dp"
                android:paddingBottom="10dp"
                android:text="@string/loading_map"
                android:textColor="@color/white"
                android:visibility="invisible" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/book_taxi_main_frag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottomViewLay"
            android:layout_alignParentBottom="true">

        </FrameLayout>

        <LinearLayout
            android:id="@+id/txt_skip_drop_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/fav_bot_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

            </LinearLayout>


            <!-- <TextView
                 android:id="@+id/txt_skip_drop"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:drawableEnd="@drawable/skip"
                 android:drawablePadding="10dp"
                 android:gravity="center"
                 android:onClick="@{() -> myBookViewModel.skipDropLocClick(1)}"
                 android:padding="20dp"
                 android:text="@string/skip_drop_location"
                 android:textColor="@color/button_accept"
                 android:visibility="visible" />
 -->

            <TextView
                android:id="@+id/txt_skip_drop"
                style="@style/enterTxt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_marginBottom="5dp"
                android:background="@drawable/button_rect"
                android:fontFamily="@font/normalfont"
                android:gravity="center"
                android:onClick="@{() -> myBookViewModel.skipDropLocClick(1)}"
                android:padding="@dimen/dp_10"
                android:text="@string/book_ride"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/mov_cur_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/book_taxi_main_frag"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="@dimen/dp_10"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="05dp"
            android:visibility="visible"
            app:backgroundTint="@android:color/white"
            app:srcCompat="@drawable/current_loc" />


        <LinearLayout
            android:id="@+id/ll_choose_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

            </androidx.recyclerview.widget.RecyclerView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomViewLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_iv_line"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:visibility="gone" />

            <com.taximobility.bookingmodule.utils.CarModelsView
                android:id="@+id/car_model_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:fillViewport="true"
                android:visibility="gone" />

            <include
                android:id="@+id/request_lay"
                layout="@layout/book_bottom_view"
                android:visibility="gone"
                bind:myBookViewModel="@{myBookViewModel}" />

        </LinearLayout>
    </RelativeLayout>

</layout>