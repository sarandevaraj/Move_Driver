<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable

            name="list"

            type="com.moovex.driver.data.apiData.DriverListClass" />

    </data>

    <LinearLayout

        android:id="@+id/main_lay"

        android:layout_width="match_parent"

        android:layout_height="@dimen/dp_40"

        android:layout_marginBottom="1dp"

        android:layout_marginTop="@dimen/dp_10"

        android:gravity="center"

        android:padding="@dimen/dp_3"

        android:weightSum="4">

        <TextView

            android:id="@+id/txt_trip_id"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="@{Integer.toString(list._id)}"

            android:textColor="@color/black"

            android:visibility="gone"

            />

        <TextView

            android:id="@+id/txt_date"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="@{list.settlement_request_date}"

            android:textColor="@color/black"

            />

        <TextView

            android:id="@+id/txt_paymentBy"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="@{list.settlement_type}"

            android:textColor="@color/black"

            />

        <TextView

            android:id="@+id/txt_amount"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="@{Double.toString(list.settlement_process_amount)}"

            android:textColor="@color/black"

            />

        <androidx.appcompat.widget.AppCompatImageView

            android:id="@+id/txt_status"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center" />

    </LinearLayout>

</layout>