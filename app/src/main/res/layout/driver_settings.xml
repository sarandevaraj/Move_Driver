<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:layout_alignParentTop="true"
        android:padding="10dp"
        tools:background="@color/button_accept">


        <ImageView
            android:id="@+id/slideImg"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_back_white" />

        <TextView
            android:id="@+id/headerTxt"
            style="@android:style/TextAppearance.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <!--        <TextView-->
        <!--            android:id="@+id/donebtn"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_alignParentRight="true"-->
        <!--            android:layout_centerVertical="true"-->
        <!--            android:layout_marginRight="10dp"-->
        <!--            android:background="@color/black"-->
        <!--            android:paddingLeft="10dp"-->
        <!--            android:paddingTop="05dp"-->
        <!--            android:paddingRight="10dp"-->
        <!--            android:paddingBottom="05dp"-->
        <!--            android:text="@string/save"-->
        <!--            android:visibility="visible"-->
        <!--            android:textColor="@color/white" />-->


        <TextView
            android:id="@+id/btnlogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:background="@color/black"
            android:paddingLeft="10dp"
            android:paddingTop="05dp"
            android:paddingRight="10dp"
            android:paddingBottom="05dp"
            android:text="@string/m_logout"
            android:textColor="@color/white"
            android:visibility="gone" />
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/privacy_lay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/white_corner_bg"
        android:elevation="@dimen/dp_10"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/personal_details_lay">


        <TextView
            android:id="@+id/edit_profile_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_5"
            android:background="@color/white"
            android:padding="14dp"
            android:text="@string/edit_profile"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_14"
            app:drawableRightCompat="@drawable/google_ic_right_small" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginEnd="@dimen/dp_15"
            android:background="@color/separator_line" />

        <TextView
            android:id="@+id/bt_privacysettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/dp_5"
            android:background="@color/white"
            android:gravity="left"
            android:padding="14dp"
            android:text="Privacy Settings"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_14"
            android:visibility="visible"
            app:drawableRightCompat="@drawable/google_ic_right_small" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginEnd="@dimen/dp_15"
            android:background="@color/separator_line" />

        <TextView
            android:id="@+id/notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_5"
            android:background="@color/white"
            android:padding="14dp"
            android:text="@string/notification_setting"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_14"
            android:visibility="gone"
            app:drawableRightCompat="@drawable/right_arrow" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginEnd="@dimen/dp_15"
            android:background="@color/separator_line"
            android:visibility="gone" />

        <TextView
            android:id="@+id/log_out_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_5"
            android:background="@color/white"
            android:padding="14dp"
            android:text="@string/m_logout"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_14"
            app:drawableRightCompat="@drawable/google_ic_right_small" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginEnd="@dimen/dp_15"
            android:background="@color/separator_line" />


    </LinearLayout>


</LinearLayout>