<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:id="@+id/content">

    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:layout_alignParentTop="true"
        android:background="@color/button_accept"
        android:padding="10dp">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/slideImg"
            android:padding="@dimen/dp_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_back_white"
            android:visibility="visible" />

        <TextView
            android:id="@+id/headerTxt"
            style="@android:style/TextAppearance.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/privacy_settings"
            android:textColor="@color/white" />



    </RelativeLayout>
    <FrameLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_below="@+id/slide_lay"
        android:foreground="@drawable/driver_background_shadow"
        android:visibility="gone">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>
<!--<TextView
    android:id="@+id/deleteacc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/del_acc"
    android:layout_margin="15dp"
    android:textColor="@color/white"
    android:background="@drawable/button_rect"
    android:layout_below="@+id/shadow"
    android:gravity="center"
    android:padding="@dimen/dp_10"/>-->


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/deleteacc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="15dp"
        android:background="@drawable/button_rect"
        android:text="@string/del_acc"
        android:layout_below="@+id/shadow"
        android:textAllCaps="false"
        android:textColor="@color/white" />

</RelativeLayout>