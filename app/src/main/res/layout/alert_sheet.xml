<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/sheet_title"
        style="@style/enterTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="@dimen/sp_20"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:textStyle="bold"
        android:text="Log out"
        android:textColor="@color/block"/>

    <View
        android:id="@+id/view_logout"
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:visibility="gone"
        android:layout_marginVertical="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_40"
        android:background="@color/grey_color_new"
        app:layout_constraintTop_toBottomOf="@id/sheet_title"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/title_txt"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginVertical="15dp"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:text="hjkhjk"
        android:textSize="@dimen/sp_18"
        android:fontFamily="@font/boldfont"
        android:paddingTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/sheet_title"
        android:layout_below="@+id/tems_txt"
        android:textColor="@color/black"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/cancel_btn"
        android:layout_width="0dp"
        android:layout_height="@dimen/tool_bar_bottom"
        android:layout_below="@+id/tems_txt"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="15dp"
        android:background="@null"
        android:fontFamily="@font/normalfont"
        android:textAllCaps="false"
        android:gravity="center"
        android:layout_marginLeft="@dimen/dp_10"
        android:text="@string/cancel"
        android:textSize="@dimen/sp_16"
        android:textColor="@color/sub_heading_light"
        app:layout_constraintEnd_toStartOf="@id/submit_btn"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_txt" />

    <Button
        android:id="@+id/submit_btn"
        android:layout_width="0dp"
        android:layout_height="@dimen/tool_bar_bottom"
        android:layout_below="@+id/tems_txt"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="35dp"
        android:background="@drawable/button_rect"
        android:fontFamily="@font/normalfont"
        android:gravity="center"
        android:text="@string/ok"
        android:textAllCaps="false"
        android:textSize="@dimen/sp_16"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/cancel_btn"
        app:layout_constraintTop_toBottomOf="@id/title_txt" />


    <View
        android:layout_width="fill_parent"
        android:layout_height="0.5dp"
        android:layout_marginVertical="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_40"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/submit_btn" />



</androidx.constraintlayout.widget.ConstraintLayout>