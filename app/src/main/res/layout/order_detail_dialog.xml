                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:hint="@string/zero"
                    android:textColor="@color/block" />
            </LinearLayout>

