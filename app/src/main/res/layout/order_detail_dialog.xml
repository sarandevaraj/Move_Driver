                        <TextView
                            android:id="@+id/v_product_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:inputType="none"
                            android:maxLength="8"
                            android:textColor="@color/block" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
