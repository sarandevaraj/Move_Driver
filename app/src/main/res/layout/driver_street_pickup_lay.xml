<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ongoing_lay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/no_taxi_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/no_taxi_assigned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/button_accept"
            android:gravity="center"
            android:maxLines="4"
            android:padding="15dp"
            android:textColor="@color/white" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:background="@color/white">

        <TextView
            android:id="@+id/slideImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:background="@drawable/driver_back"
            android:visibility="visible" />

        <TextView
            android:id="@+id/btn_shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:background="@drawable/driver_shiftbg"
            android:gravity="center"
            android:maxWidth="120dp"
            android:minWidth="70dp"
            android:minHeight="30dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:text="online"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/backup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:drawableLeft="@drawable/driver_backbtn"
            android:gravity="left"
            android:padding="5dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/km_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@color/transparent"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/total_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/total_km"

                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@drawable/driver_green_to_white"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/waiting_time"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/draw_timer_bg"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerTxt"
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/headicon"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_centerInParent="true"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/headerTxt"
            android:gravity="center"

            android:visibility="gone"
            app:srcCompat="@drawable/driver_headicon" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_emergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:background="@drawable/driver_emergency_contact_btn"
            android:gravity="center"
            android:maxWidth="120dp"
            android:minWidth="70dp"
            android:minHeight="30dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:text="@string/emergency"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:foreground="@drawable/driver_background_shadow_light"
        android:visibility="gone">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>

    <LinearLayout
        android:id="@+id/progresss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nodataTxt"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center"
            android:visibility="visible" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/mapsupport_lay"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/white"
        android:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.taximobility.driver.utils.DriverStreetMapWrapperLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/map_relative_layout"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical">

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />

            </com.taximobility.driver.utils.DriverStreetMapWrapperLayout>

            <ImageView
                android:id="@+id/map_icon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:paddingBottom="30dp"
                android:visibility="gone"
                app:srcCompat="@drawable/driver_flag_green" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tripdetail_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">


            <RelativeLayout
                android:id="@+id/searchlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <RelativeLayout

                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tripinprogress_lay"
                    android:layout_marginStart="@dimen/dp_15"
                    android:layout_marginTop="@dimen/pad_30dp"
                    android:layout_marginEnd="@dimen/dp_15"
                    android:background="@drawable/white_corner_bg"
                    android:orientation="vertical"
                   android:elevation="@dimen/dp_10">

                    <FrameLayout
                        android:id="@+id/pickup_pinlay_n"
                        android:layout_width="wrap_content"
                        android:layout_height="140dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerInParent="true"
                        android:visibility="visible">

                        <ImageView

                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/pad_100dp"
                            android:layout_gravity="center_vertical|center_horizontal"
                            android:contentDescription="@null"
                            android:gravity="bottom"
                            android:paddingStart="@dimen/taxi__search_padding_medium"
                            android:paddingEnd="@dimen/dp_8"
                            app:srcCompat="@drawable/ic_pickup_drop" />
                    </FrameLayout>


                    <LinearLayout
                        android:id="@+id/tapCurrentLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_toEndOf="@+id/pickup_pinlay_n"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:weightSum="1">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:padding="@dimen/dp_2"
                            android:paddingStart="@dimen/dp_10"
                            android:text="PICKUP"
                            android:textSize="10sp">

                        </TextView>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/pick_pin"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:paddingLeft="8dp"
                                android:src="@drawable/dot"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/currentlocTxt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"

                                android:drawablePadding="@dimen/dp_10"
                                android:fadingEdge="horizontal"
                                android:gravity="center_vertical"
                                android:hint="@string/picklocation"
                                android:lines="1"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:paddingStart="@dimen/dp_10"
                                android:paddingTop="@dimen/taxi__search_padding_medium"
                                android:paddingEnd="@dimen/pad_15dp"
                                android:paddingBottom="@dimen/taxi__search_padding_medium"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/black"
                                android:textColorHint="@color/hintcolor"
                                android:textSize="16sp" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/pic_loc_select"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/pad_5dp"
                                android:layout_weight="0.1"
                                android:clickable="true"
                                android:focusable="true"
                                android:visibility="gone"
                                app:srcCompat="@drawable/ic_favorite_unselect" />


                        </LinearLayout>


                    </LinearLayout>

                    <View
                        android:id="@+id/pickup_drop_Sep"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_below="@id/tapCurrentLocation"
                        android:layout_marginRight="@dimen/dp_15"
                        android:layout_toEndOf="@+id/pickup_pinlay_n"
                        android:background="@color/linebottom_light" />

                    <LinearLayout
                        android:id="@+id/drop_lay_n"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/pickup_drop_Sep"
                        android:layout_toEndOf="@+id/pickup_pinlay_n"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:padding="@dimen/dp_2"
                            android:paddingStart="8dp"
                            android:text="DROP-OFF"
                            android:textSize="12sp"
                            android:visibility="visible">

                        </TextView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/drop_pin1"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:paddingStart="8dp"
                                android:src="@drawable/circle_red"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/droplocTxt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"

                                android:drawablePadding="@dimen/dp_10"
                                android:fadingEdge="horizontal"
                                android:gravity="center_vertical"
                                android:hint="@string/droploc"
                                android:lines="1"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:paddingStart="@dimen/dp_10"
                                android:paddingTop="@dimen/taxi__search_padding_medium"
                                android:paddingEnd="@dimen/pad_15dp"
                                android:paddingBottom="@dimen/taxi__search_padding_medium"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/black"
                                android:textColorHint="@color/hintcolor"
                                android:textSize="16sp" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/drop_loc_select"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/pad_5dp"
                                android:layout_weight="0.1"
                                android:visibility="invisible"
                                app:srcCompat="@drawable/ic_favorite_unselect" />

                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>




                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_view_pickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:id="@+id/pickup_pinlay"
                                android:layout_width="wrap_content"
                                android:layout_height="91dp"
                                android:visibility="gone">

                                <ImageView
                                    android:id="@+id/drop_pin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="2dp"
                                    android:paddingLeft="8dp"
                                    app:srcCompat="@drawable/driver_location" />
                            </FrameLayout>


                            <LinearLayout
                                android:id="@+id/pickupp"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                android:layout_toRightOf="@+id/pickup_pinlay"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/pickup_location_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:paddingLeft="3dp"
                                    android:paddingRight="3dp"
                                    android:text="@string/pickup_location"
                                    android:textColor="@color/popup_heading"
                                    android:textSize="12sp" />


                                <LinearLayout
                                    android:id="@+id/tapCurrentLocation"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/pickup_pin"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:paddingLeft="8dp"
                                        android:visibility="visible"
                                        app:srcCompat="@drawable/driver_dot" />


                                    <TextView

                                        android:layout_width="fill_parent"
                                        android:layout_height="30dp"
                                        android:layout_marginLeft="5dp"
                                        android:layout_weight="0.2"
                                        android:ellipsize="marquee"
                                        android:fadingEdge="horizontal"
                                        android:focusable="true"
                                        android:focusableInTouchMode="true"
                                        android:gravity="center"
                                        android:hint="@string/picklocation"
                                        android:marqueeRepeatLimit="marquee_forever"
                                        android:scrollHorizontally="true"
                                        android:singleLine="true"
                                        android:textColor="@color/black"
                                        android:textColorHint="@color/hintcolor"
                                        android:textSize="15sp" />

                                    <LinearLayout
                                        android:id="@+id/lay_pick_fav"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:paddingLeft="8dp"
                                        android:paddingTop="5dp"
                                        android:paddingRight="8dp"
                                        android:paddingBottom="5dp"
                                        android:visibility="visible">

                                        <ImageView
                                            android:id="@+id/pick_fav"
                                            android:layout_width="15dp"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:gravity="center"
                                            android:visibility="gone"
                                            app:srcCompat="@drawable/driver_plus1" />
                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                            <!-- <RelativeLayout
                                 android:id="@+id/lay_pick_faveeee"
                                 android:layout_width="wrap_content"
                                 android:layout_height="match_parent"
                                 android:layout_gravity="center"
                                 android:gravity="center"
                                 android:layout_alignParentEnd="true"
                                 android:paddingBottom="5dp"
                                 android:paddingLeft="8dp"
                                 android:paddingRight="8dp"
                                 android:paddingTop="5dp"
                                  android:layout_marginBottom="40dp"
                                 android:visibility="gone">

                                 <ImageView
                                     android:id="@+id/pick_fav"
                                     android:layout_width="15dp"
                                     android:layout_height="15dp"
                                      android:gravity="center"
                                     android:src="@drawable/plus1" />

                             </RelativeLayout>-->

                            <View
                                android:id="@+id/pickup_drop_Sep"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_below="@id/pickupp"
                                android:background="@color/linebottom_light"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/dropppp"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_below="@id/pickup_drop_Sep"
                                android:layout_toRightOf="@id/pickup_pinlay"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
                                    android:id="@+id/initial_drop_pin"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center"
                                    android:paddingLeft="8dp"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/driver_circle_red" />

                                <TextView
                                    android:id="@+id/droplocTxt"
                                    android:layout_width="fill_parent"
                                    android:layout_height="40dp"
                                    android:layout_weight="0.2"
                                    android:ellipsize="marquee"
                                    android:fadingEdge="horizontal"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:gravity="center"
                                    android:hint="@string/droplocnew"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:padding="5dp"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/hintcolor"
                                    android:textSize="15sp" />

                                <LinearLayout
                                    android:id="@+id/drop_fav"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:paddingLeft="8dp"
                                    android:paddingTop="5dp"
                                    android:paddingRight="8dp"
                                    android:paddingBottom="5dp"
                                    android:visibility="gone">

                                    <ImageView
                                        android:id="@+id/drop_close"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        app:srcCompat="@drawable/driver_close" />
                                </LinearLayout>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
            </RelativeLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_currentloc_initial_1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="right"
                android:layout_margin="5dp"
                android:paddingLeft="05dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:fabCustomSize="50dp"
                app:layout_anchor="@id/searchlay"
                app:layout_anchorGravity="bottom|right|end"
                app:srcCompat="@drawable/driver_current_loc" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_emergency_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/driver_emergency_contact_btn"
                android:backgroundTint="@color/button_accept"
                android:gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:maxWidth="120dp"
                android:minWidth="70dp"
                android:minHeight="30dp"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:text="@string/emergency"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/tripdetail_layout"
            android:layout_alignParentRight="true"
            android:gravity="bottom|end">

            <ImageView
                android:id="@+id/botton_layout"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="right"
                android:layout_marginRight="5dp"
                android:paddingLeft="05dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/botton_navi"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="right"
                android:layout_marginRight="5dp"
                android:paddingLeft="05dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingBottom="5dp"
                android:src="@drawable/driver_current_loc"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:fabCustomSize="50dp"
                app:layout_anchorGravity="top|right|end" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/bottomlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom"
            android:visibility="visible">

            <include
                layout="@layout/driver_ongoing_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:visibility="visible" />
            <!-- <Button
                 android:id="@+id/butt_onboard"
                 android:layout_width="fill_parent"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:background="@drawable/back_black_to_white"
                 android:gravity="center"
                 android:padding="5dp"
                 android:tag="Arrived"
                 android:textColor="@drawable/text_color_black_to_white" />-->
        </RelativeLayout>


    </RelativeLayout>


</LinearLayout>