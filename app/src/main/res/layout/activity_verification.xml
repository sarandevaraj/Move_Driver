<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/otproot_lay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:visibility="visible">
        <!--  -->

        <ImageView
            android:id="@+id/back_click"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/back" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/otp_verify_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/dp_12"
        android:visibility="visible">

        <TextView
            android:id="@+id/txt_verifyotp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="05dp"
            android:fontFamily="@font/boldfont"
            android:text="@string/verify_otp"
            android:textColor="@color/black"

            android:textSize="20sp" />

        <TextView
            android:id="@+id/txt_smspin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_verifyotp"
            android:layout_marginLeft="05dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/sub_heading"
            android:text="@string/enter_pin" />

        <TextView
            android:id="@+id/edt_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_smspin"
            android:layout_marginLeft="05dp"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/normalfont"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/edt_num"

            android:textColor="@color/block"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/otp_lay"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/edt_num"
            android:layout_marginLeft="05dp"
            android:layout_marginRight="05dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pass_txt"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/verifyno1Txt"
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:fontFamily="@font/normalfont"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="20dp"
                    android:paddingRight="10dp"
                    android:backgroundTint="@color/text_filed"
                    android:textColor="@color/textviewcolor_dark"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="@dimen/text_elarge" />




            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pass_txt"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/verifyno2Txt"
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:digits="0123456789"
                    android:fontFamily="@font/normalfont"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="20dp"
                    android:backgroundTint="@color/text_filed"
                    android:paddingRight="10dp"
                    android:textColor="@color/textviewcolor_dark"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="@dimen/text_elarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pass_txt"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/verifyno3Txt"
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:fontFamily="@font/normalfont"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="20dp"
                    android:backgroundTint="@color/text_filed"
                    android:paddingRight="10dp"
                    android:textColor="@color/textviewcolor_dark"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="@dimen/text_elarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pass_txt"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/verifyno4Txt"
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:fontFamily="@font/normalfont"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="1"
                    android:backgroundTint="@color/text_filed"
                    android:paddingLeft="10dp"
                    android:paddingTop="20dp"
                    android:paddingRight="10dp"
                    android:textColor="@color/textviewcolor_dark"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="@dimen/text_elarge" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/otp_lay"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resend_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:paddingTop="5dp"
                android:textColor="@color/sub_heading"
                android:paddingBottom="5dp"
                android:text="@string/resend_code" />

            <LinearLayout
                android:id="@+id/timer_lays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/minstext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/sub_heading"
                    android:gravity="center"
                    android:paddingLeft="3dp"
                    android:paddingTop="5dp"

                    android:paddingBottom="5dp"
                    android:text="00" />

                <TextView
                    android:id="@+id/colon_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub_heading"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    android:text=":" />

                <TextView
                    android:id="@+id/secsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/sub_heading"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    android:text="49" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/otp_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/normalfont"
            android:textColor="#000004"
            android:textSize="16sp"

            android:visibility="gone" />


        <TextView
            android:id="@+id/submit_otp"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/tool_bar_bottom"
            android:layout_below="@+id/tems_txt"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="15dp"
            android:background="@drawable/button_rect"
            android:textSize="@dimen/sp_16"
            android:fontFamily="@font/normalfont"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"
            android:text="@string/submit"
            />

        <Button


            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginLeft="04dp"
            android:layout_marginRight="03dp"
            android:background="@color/button_accept"
            android:fontFamily="@font/boldfont"
            android:textAllCaps="false"

            android:textColor="@color/white"
            android:visibility="gone" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/verify_password_lay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_verifypassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="05dp"
            android:fontFamily="@font/normalfont"

            android:text="@string/verify_ur_password"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/text_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_verifypassword"
            android:layout_marginLeft="05dp"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/normalfont"

            android:text="@string/welcome_continue" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pass_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/text_password"

            android:layout_marginTop="10dp"
            android:hint="@string/enter_ur_password"
            app:passwordToggleEnabled="true">

            <EditText
                android:paddingLeft="4dp"
                android:background="@color/transparent"
                android:id="@+id/edt_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="32" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@+id/edt_referal"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="6dp"
                android:background="@color/text_filed" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_below="@+id/pass_txt"
            android:layout_marginTop="@dimen/dp_20"
            android:id="@+id/forget_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:padding="5dp"
            android:text="@string/forgotpswd"
            android:textColor="@color/button_accept"
            android:textSize="16sp" />

        <Button
            android:id="@+id/continue_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="25dp"
            android:background="@drawable/button_rect"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textSize="@dimen/sp_16"
            android:fontFamily="@font/normalfont"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </RelativeLayout>


</LinearLayout>