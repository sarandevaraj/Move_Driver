<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signinlayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:focusableInTouchMode="false"
    android:orientation="vertical">

    <include
        layout="@layout/driver_include_headler"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_below="@+id/slide_lay"
        android:foreground="@drawable/driver_background_shadow"
        android:visibility="gone">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>


    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center"
        android:layout_margin="@dimen/dp_12"
        android:background="@color/white">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@+id/t_c_web_txt"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/dp_2"
            android:background="@color/white">

            <TextView
                android:id="@+id/signup_lbl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:fontFamily="@font/boldfont"
                android:text="@string/signin"
                android:visibility="gone"
                android:textColor="@color/block"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/signup_lbl"
                android:layout_marginTop="@dimen/dp_8"
                android:visibility="gone"
                android:fontFamily="@font/normalfont"
                android:text="@string/sign_up_acc"
                android:textColor="@color/sub_heading"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imageview"
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="100dp" />


            <EditText
                android:id="@+id/phoneEdt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/white"
                android:drawablePadding="5dp"
                android:fontFamily="@font/normalfont"
                android:drawableLeft="@drawable/google_ic_phone"
                android:hint="@string/phone"
                android:inputType="number"
                android:maxLength="13"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@color/sub_heading"
                android:textSize="@dimen/sp_20"
                android:layout_below="@+id/imageview"
                android:layout_marginTop="@dimen/dp_40"

                />

            <View
                android:id="@+id/viewborder"
                android:layout_width="fill_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/phoneEdt"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/text_filed" />

            <RelativeLayout
                android:id="@+id/passwordlay"
                android:layout_marginTop="5dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewborder"
                android:background="@color/white">


                <ImageView
                    android:id="@+id/hidePwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="5dp"
                    android:padding="9dp"
                    android:src="@drawable/google_ic_password_show"
                    android:textColor="@color/block"
                    android:visibility="visible" />


                <EditText
                    android:id="@+id/password_Edt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_toLeftOf="@+id/hidePwd"
                    android:background="@color/white"
                    android:drawablePadding="5dp"
                    android:fontFamily="@font/normalfont"
                    android:drawableLeft="@drawable/google_ic_password"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:maxLength="32"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/sub_heading"
                    android:textSize="@dimen/sp_20" />
            </RelativeLayout>


            <View
                android:id="@+id/viewborderdown"
                android:layout_width="fill_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/passwordlay"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/text_filed" />

            <TextView
                android:id="@+id/signup_web"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewborderdown"
                android:layout_alignBaseline="@+id/forgotpswdTxt"
                android:layout_gravity="right|center_vertical"
                android:layout_marginLeft="10dp"
                android:text="@string/signup"
                android:textColor="@color/textviewcolor_dark"
                android:textColorHint="@color/hintcolor"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/forgotpswdTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewborderdown"
                android:layout_alignParentRight="true"
                android:layout_gravity="right|center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginRight="5dp"
                android:fontFamily="@font/normalfont"
                android:gravity="right"
                android:text="@string/forgotpswd"
                android:textColor="@color/black"
                android:textSize="@dimen/dp_18" />
        </RelativeLayout>

        <TextView
            android:id="@+id/t_c_web_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/doneBtn1"
            android:layout_gravity="right|center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="5dp"
            android:text="@string/terms_condition"
            android:textColorHint="@color/hintcolor"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/driver_pass_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/doneBtn1"
            android:layout_marginBottom="@dimen/dp_20"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="@dimen/pad_30dp"
                    android:layout_height="@dimen/pad_30dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/ic_driver_login" />

                <TextView
                    android:id="@+id/become_driver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="10dp"
                    android:gravity="center"
                    android:textSize="@dimen/dp_18"
                    android:text="@string/become_driver"
                    android:textColor="@color/black"


                    />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone"
                android:background="@color/linebottom_light" />


            <LinearLayout
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="@dimen/pad_30dp"
                    android:layout_height="@dimen/pad_30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_passenger_login" />

                <TextView
                    android:id="@+id/become_pass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center"
                    android:layout_marginLeft="10dp"
                    android:gravity="center"
                    android:text="@string/become_passenger"
                    android:textColor="@color/black" />
            </LinearLayout>


        </LinearLayout>

        <TextView
            android:id="@+id/doneBtn1"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/tool_bar_bottom"
            android:layout_alignParentBottom="true"
            android:background="@drawable/button_rect"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/s_signin"
            android:textSize="@dimen/sp_16"
            android:fontFamily="@font/normalfont"
            android:textColor="@color/white"
            android:textStyle="bold" />


    </RelativeLayout>


</LinearLayout>