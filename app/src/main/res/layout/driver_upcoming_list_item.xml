<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/trip_details_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_12"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/map_image"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/book_lay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <com.movedriver.driver.utils.DriverRoundedImageView
                    android:id="@+id/driver_image"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/driver_loadingimage" />

                <RelativeLayout
                    android:id="@+id/trip_time_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/driver_image"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/pad_5dp">

                            <TextView
                                android:id="@+id/trip_driver_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/normalfont"
                                android:text="name"
                                android:textColor="@color/block"
                                android:textSize="@dimen/dp_20"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trip_track"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:background="@drawable/driver_rect_red"
                                android:paddingLeft="5dp"
                                android:paddingTop="5dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="5dp"
                                android:text="@string/track_now"
                                android:textColor="@color/button_accept"
                                android:visibility="gone" />


                            <ImageView
                                android:id="@+id/call_driver"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="right|center"
                                android:layout_marginTop="@dimen/dp_2"
                                android:drawablePadding="@dimen/dp_5"
                                android:gravity="right|center"
                                android:visibility="gone"
                                card_view:srcCompat="@drawable/ic_green_call_new" />


                        </LinearLayout>


                        <!--                            <TextView-->
                        <!--                                android:id="@+id/trip_driver_name"-->
                        <!--                                android:layout_width="wrap_content"-->
                        <!--                                android:layout_height="wrap_content"-->
                        <!--                                android:layout_below="@+id/trip_time"-->
                        <!--                                android:layout_marginTop="@dimen/dp_10"-->
                        <!--                                android:layout_toRightOf="@+id/driver_image"-->
                        <!--                                android:fontFamily="@font/normalfont"-->
                        <!--                                android:paddingLeft="5dp"-->
                        <!--                                android:textColor="@color/block"-->
                        <!--                                tools:text="Test" />-->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/pad_5dp">

                            <TextView
                                android:id="@+id/approx_fare"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/normalfont"
                                android:text="$20.00"
                                android:textColor="@color/block"
                                android:textSize="16dp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/divider"
                                android:layout_width="0.1dp"
                                android:layout_height="@dimen/dp_15"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/dp_15"
                                android:background="@color/sub_heading_light" />

                            <TextView
                                android:id="@+id/approx_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_15"
                                android:drawablePadding="@dimen/dp_5"
                                android:fontFamily="@font/normalfont"
                                android:gravity="right"
                                android:text="10.0KM"
                                android:textColor="@color/block"
                                android:textSize="@dimen/dp_16"
                                android:textStyle="bold" />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:orientation="horizontal"
                            android:padding="@dimen/pad_5dp">

                            <TextView
                                android:id="@+id/model_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/normalfont"
                                android:text="@string/pickup_time"
                                android:textColor="@color/sub_heading"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_5"
                                android:text="-"
                                android:textColor="@color/sub_heading" />

                            <TextView
                                android:id="@+id/trip_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_5"
                                android:fontFamily="@font/normalfont"
                                android:gravity="right"
                                android:text="10.0KM"
                                android:textColor="@color/sub_heading"
                                android:textSize="14sp"
                                android:textStyle="bold" />


                        </LinearLayout>


                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/can_track"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"

                        android:layout_centerVertical="true"
                        android:layout_gravity="right">


                        <TextView
                            android:id="@+id/trip_cancel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="8dp"
                            android:background="@drawable/driver_cancelbg"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="5dp"
                            android:text="@string/cancel"
                            android:textColor="@color/black"
                            android:visibility="gone" />
                    </FrameLayout>

                </RelativeLayout>
z
                <LinearLayout
                    android:id="@+id/pick_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/trip_time_lay"
                    android:layout_marginTop="@dimen/dp_4"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/pad_30dp"
                        android:layout_height="@dimen/pad_30dp"
                        android:layout_gravity="center"
                        android:padding="5dp"
                        card_view:srcCompat="@drawable/google_ic_marker" />

                    <TextView
                        android:id="@+id/txt_pickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_weight="0.9"
                        android:drawablePadding="@dimen/dp_10"
                        android:fadingEdge="horizontal"
                        android:gravity="center_vertical"
                        android:hint="@string/picklocation"
                        android:lines="1"

                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="@string/picklocation"
                        android:textColor="@color/sub_heading"
                        android:textColorHint="@color/hintcolor"
                        android:textSize="16sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/pick_lay"
                    android:layout_marginTop="@dimen/dp_2"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/drop_icon"
                        android:layout_width="@dimen/pad_30dp"
                        android:layout_height="@dimen/pad_30dp"
                        android:layout_gravity="center"
                        android:padding="6dp"
                        card_view:srcCompat="@drawable/google_ic_marker" />


                    <TextView
                        android:id="@+id/txt_drop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fadingEdge="horizontal"
                        android:gravity="center"
                        android:hint="@string/droploc"
                        android:lines="1"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="@string/droploc"
                        android:textColor="@color/sub_heading"
                        android:textColorHint="@color/hintcolor"
                        android:textSize="16sp" />
                </LinearLayout>


            </RelativeLayout>

            <View

                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_above="@+id/con_lay"
                android:layout_marginStart="@dimen/dp_10"

                android:layout_marginTop="@dimen/sp_14"
                android:background="@color/separator_line" />


        </LinearLayout>
    </LinearLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/bookLaterLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        card_view:cardCornerRadius="4dp"
        card_view:cardUseCompatPadding="true"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dp_5"
            android:visibility="gone">

            <com.movedriver.driver.utils.DriverRoundedImageView
                android:id="@+id/passengerImg"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginBottom="@dimen/dp_10"
                android:src="@drawable/driver_loadingimage"
                card_view:layout_constraintBottom_toBottomOf="parent"
                card_view:layout_constraintEnd_toStartOf="@id/passengerPhoneTxt"
                card_view:layout_constraintStart_toStartOf="parent"
                card_view:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/passengerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:text="@string/pickup_passenger"
                android:textSize="18sp"
                android:textStyle="bold"
                card_view:layout_constraintStart_toEndOf="@+id/passengerImg"
                card_view:layout_constraintTop_toTopOf="parent" />

            <com.movedriver.driver.pdview.DriverPickupDropView
                android:id="@+id/pd_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                card_view:layout_constraintStart_toEndOf="@+id/passengerImg"
                card_view:layout_constraintTop_toBottomOf="@+id/passengerName" />

            <TextView
                android:id="@+id/pickupTimeTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:text="@string/pickup_time"
                android:textStyle="bold"
                card_view:layout_constraintStart_toEndOf="@+id/passengerImg"
                card_view:layout_constraintTop_toBottomOf="@+id/pd_view" />

            <TextView
                android:id="@+id/updateTimeTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_5"
                android:drawableStart="@drawable/driver_ic_access_time"
                android:text="@string/pickup_time"
                android:textStyle="bold"
                card_view:layout_constraintEnd_toStartOf="@+id/updateDisTxt"
                card_view:layout_constraintHorizontal_bias="0.5"
                card_view:layout_constraintStart_toEndOf="@+id/passengerImg"
                card_view:layout_constraintTop_toBottomOf="@+id/pickupTimeTxt" />


            <TextView
                android:id="@+id/updateDisTxt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dp_10"
                android:drawableStart="@drawable/driver_distance_icon"
                android:drawablePadding="@dimen/dp_5"
                android:gravity="center"
                android:text="@string/t_distance"
                android:textStyle="bold"
                card_view:layout_constraintBaseline_toBaselineOf="@+id/updateTimeTxt"
                card_view:layout_constraintEnd_toEndOf="parent"
                card_view:layout_constraintHorizontal_bias="0.5"
                card_view:layout_constraintStart_toEndOf="@+id/updateTimeTxt" />

            <TextView
                android:id="@+id/passengerPhoneTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_5"
                android:text="@string/passenger_phone"
                android:visibility="gone"
                card_view:layout_constraintStart_toEndOf="@id/passengerImg"
                card_view:layout_constraintTop_toBottomOf="@+id/updateTimeTxt" />


            <TextView
                android:id="@+id/passengerCallTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_5"
                android:background="@drawable/driver_cancelbg"
                android:gravity="center"
                android:padding="@dimen/dp_5"
                android:text="@string/passenger_phone"
                card_view:layout_constraintBottom_toBottomOf="parent"
                card_view:layout_constraintHorizontal_bias="0.5"
                card_view:layout_constraintStart_toEndOf="@+id/passengerImg"
                card_view:layout_constraintTop_toBottomOf="@+id/updateTimeTxt" />


            <TextView
                android:id="@+id/cancelTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:background="@drawable/driver_rect_red"
                android:gravity="center"
                android:padding="@dimen/dp_5"
                android:text="@string/cancel"
                card_view:layout_constraintBaseline_toBaselineOf="@id/passengerCallTxt"
                card_view:layout_constraintEnd_toStartOf="@+id/startTripTxt"
                card_view:layout_constraintHorizontal_bias="0.5"
                card_view:layout_constraintStart_toEndOf="@+id/passengerCallTxt" />

            <TextView
                android:id="@+id/startTripTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:background="@drawable/driver_cancelbg"
                android:gravity="center"
                android:padding="@dimen/dp_5"
                android:text="@string/start_trip"
                card_view:layout_constraintBaseline_toBaselineOf="@id/passengerCallTxt"
                card_view:layout_constraintEnd_toEndOf="parent"
                card_view:layout_constraintHorizontal_bias="0.5"
                card_view:layout_constraintStart_toEndOf="@+id/cancelTxt" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
