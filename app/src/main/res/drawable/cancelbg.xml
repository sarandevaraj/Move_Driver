<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This is the line -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">

        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <stroke
                android:width="2dp"
                android:color="#000" />

            <corners android:radius="3dp" />
            <solid android:color="#ffffff" />
        </shape>
    </item>
    <!-- This is the main color -->

</layer-list>