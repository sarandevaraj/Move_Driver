<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background="@color/header_bgcolor"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/booktaxilays"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="05dp"
        android:layout_marginLeft="05dp"
        android:layout_marginRight="05dp"
        android:background="@color/button_accept"
        android:gravity="center">

        <TextView
            android:id="@+id/skip_this"
            android:layout_width="fill_parent"
            android:layout_height="48dp"
            android:background="@color/button_accept"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:text="@string/book_a_taxi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/booktaxilays"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@color/header_bgcolor"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="15dp">


            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:layout_marginRight="1dp"
                android:background="@color/header_bgcolor"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/e_recipt"
                    android:gravity="center"
                    android:orientation="vertical">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_centerInParent="true"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center"
                            android:background="@color/linebottom_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="10dp"
                            android:layout_marginTop="10dp"
                            android:background="@color/white"
                            android:gravity="center"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:singleLine="true"
                            android:text="@string/payment_complete"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/fare_amt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="8dp"
                        android:text="$0.00"
                        android:textColor="@color/black"
                        android:textSize="55dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="40dp"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="@string/thanksforflag"
                        android:textColor="@color/textviewcolor_light" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:visibility="invisible">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/app_icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/paycard_bg" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/payaccount_bg" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:visibility="invisible">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/app_icon" />
                    </LinearLayout>
                </LinearLayout>
                <include
                    layout="@layout/e_receipt_trip_fare"/>



                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/taxi__button_height"
                    android:layout_below="@+id/body_lay"
                    android:background="@android:color/transparent">

                    <View
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center"
                        android:background="@color/linebottom_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/taxi__button_height"
                        android:layout_below="@+id/body_lay"
                        android:layout_gravity="center"
                        android:background="@color/header_bgcolor"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/ratedriver"
                        android:textColor="@color/black" />
                </FrameLayout>


                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center|center_vertical"
                    android:orientation="vertical">

                    <RatingBar
                        android:id="@+id/ratingBar1"
                        style="@style/customratingbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="5"
                        android:numStars="5"
                        android:stepSize="1" />

                    <EditText
                        android:id="@+id/comment"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginLeft="05dp"
                        android:layout_marginRight="05dp"
                        android:layout_marginTop="6dp"
                        android:gravity="start"
                        android:background="@drawable/taxi_fare_rectbg"
                        android:hint="@string/type_your_comment"
                        android:maxLength="256"
                        android:maxLines="3"
                        android:padding="8dp"
                        android:textColor="@color/edittextcolor"
                        android:textColorHint="@color/hintcolor" />
                    <TextView
                        android:id="@+id/comment_txtview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="05dp"
                        android:layout_marginRight="05dp"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="10dp"
                        android:drawableRight="@drawable/tick_focus"
                        android:gravity="center"
                        android:text="@string/thanks_for_your_comment"
                        android:maxLength="256"
                        android:maxLines="3"
                        android:padding="8dp"
                        android:textSize="18sp"
                        android:textColor="@color/edittextcolor"
                        android:textColorHint="@color/hintcolor"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/submit"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="05dp"
                        android:layout_marginRight="05dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/button_accept"
                        android:gravity="center"
                        android:paddingBottom="10dp"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:paddingTop="10dp"
                        android:text="@string/submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/taxi__button_height"
                    android:layout_below="@+id/body_lay"
                    android:layout_marginLeft="05dp"
                    android:visibility="gone"
                    android:layout_marginRight="05dp"
                    android:background="@color/header_bgcolor">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center"
                        android:background="@color/linebottom_light" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/taxi__button_height"
                        android:layout_below="@+id/body_lay"
                        android:layout_gravity="center"
                        android:background="@color/header_bgcolor"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/shareride"
                        android:textColor="#010101" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/body_lay"
                    android:background="@android:color/transparent">

                    <View
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center"
                        android:background="@color/linebottom_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/taxi__button_height"
                        android:layout_below="@+id/body_lay"
                        android:layout_gravity="center"
                        android:background="@color/header_bgcolor"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/share_app"
                        android:textColor="@color/black" />
                </FrameLayout>
                <TextView
                    android:id="@+id/shareVia"
                    android:layout_width="190dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="25dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="25dp"
                    android:background="@color/button_accept"
                    android:drawableRight="@drawable/share_common_ar"
                    android:gravity="center|center_vertical"
                    android:paddingBottom="05dp"
                    android:paddingRight="10dp"
                    android:textSize="18sp"
                    android:paddingTop="10dp"
                    android:text="@string/btn_share_invite"
                     android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="40dp"
                    android:visibility="gone"
                    android:layout_marginRight="40dp"
                    android:gravity="center|center_vertical"
                    android:orientation="horizontal">


                    <ImageView
                        android:id="@+id/share1"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:src="@drawable/facebook_icon"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/share2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:src="@drawable/twitter_icon"
                        android:visibility="gone"/>
                    <ImageView
                        android:id="@+id/request_share"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:src="@drawable/twitter_icon" />
                    <ImageView
                        android:id="@+id/share3"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:src="@drawable/message_icon"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/share4"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:src="@drawable/email_icon"
                        android:visibility="gone"/>
                </LinearLayout>


            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>