<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="myBookViewModel"
            type="com.taximobility.bookingmodule.BookTaxiHomeViewModel" />
    </data>

    <RelativeLayout
        android:id="@+id/lay_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <include
            android:id="@+id/mapPageLay"
            layout="@layout/book_taxi_map_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navi_icon_book"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:layout_gravity="center"
            android:padding="15dp"
            android:scaleX="-1"
            android:src="@drawable/menu" />

        <LinearLayout
            android:id="@+id/instruction_header_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/navi_icon_book"
            android:layout_gravity="center"
            android:layout_toEndOf="@+id/navi_icon_book"
            android:gravity="center_horizontal|center_vertical">


            <TextView
                android:id="@+id/instruction_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                android:background="#424242"
                android:gravity="center"
                android:paddingLeft="30dp"
                android:paddingTop="10dp"
                android:paddingRight="30dp"
                android:paddingBottom="10dp"
                android:text="@string/loading_map"
                android:textColor="@color/white"
                android:visibility="invisible" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/book_taxi_main_frag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/navi_icon_book">

        </FrameLayout>


        <LinearLayout
            android:id="@+id/fav_bot_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/txt_skip_drop_lay"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

        </LinearLayout>


        <LinearLayout
            android:id="@+id/txt_skip_drop_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center">

            <!--   <TextView
                   android:id="@+id/txt_skip_drop"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:drawableStart="@drawable/skip"
                   android:drawablePadding="10dp"
                   android:gravity="center"
                   android:onClick="@{() -> myBookViewModel.skipDropLocClick(1)}"
                   android:padding="20dp"
                   android:rotation="180"
                   android:text="@string/skip_drop_location"
                   android:textColor="@color/button_accept"
                   android:visibility="visible" />-->

            <TextView
                android:id="@+id/txt_skip_drop"
                style="@style/enterTxt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_margin="@dimen/dp_2"
                android:background="@color/button_accept"
                android:gravity="center"
                android:onClick="@{() -> myBookViewModel.skipDropLocClick(1)}"
                android:padding="@dimen/dp_10"
                android:text="@string/book_ride"
                android:textColor="@color/buttontextcolor" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomViewLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_iv_line"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:visibility="gone" />

            <com.taximobility.bookingmodule.utils.CarModelsView
                android:id="@+id/car_model_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:fillViewport="true"
                android:visibility="gone" />

            <include
                android:id="@+id/request_lay"
                layout="@layout/book_bottom_view"
                bind:myBookViewModel="@{myBookViewModel}" />

        </LinearLayout>
    </RelativeLayout>

</layout>