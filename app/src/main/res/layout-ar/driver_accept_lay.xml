<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ongoing_lay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/no_taxi_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/no_taxi_assigned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/button_accept"
            android:gravity="center"
            android:maxLines="4"
            android:padding="15dp"
            android:textColor="@color/white" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:background="@color/header_bgcolor"
        android:visibility="gone">

        <TextView
            android:id="@+id/slideImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="@drawable/driver_back_green_to_white"
            android:padding="5dp"
            android:text="@string/back"
            android:textColor="@drawable/driver_text_color_black_to_white"
            android:textSize="16sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/backup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:drawableLeft="@drawable/driver_back"
            android:gravity="right"
            android:padding="5dp"
            android:rotation="180"
            android:visibility="visible" />


        <LinearLayout
            android:id="@+id/km_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@color/transparent"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="invisible">

            <TextView
                android:id="@+id/total_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/total_km"

                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="@string/m_timer"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@drawable/driver_green_to_white"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/waiting_time"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/draw_timer_bg"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/header_txt"
            style="@android:style/TextAppearance.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:text="@string/app_name"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/headicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/header_txt"
            android:gravity="center"
            app:srcCompat="@drawable/driver_headicon"
            android:visibility="gone" />


    </RelativeLayout>


    <FrameLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:foreground="@drawable/driver_background_shadow"
        android:visibility="gone">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>

    <TextView
        android:id="@+id/nodataTxt"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center_horizontal|center_vertical"
        android:gravity="center"
        android:text="@string/device_not_support_map"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/mapsupport_lay"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/white"
        android:visibility="visible">

        <include
            layout="@layout/driver_map_lay"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <!-- hack to fix ugly black artefact with maps v2 -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@android:color/transparent">


            <LinearLayout
                android:id="@+id/info_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                android:background="@drawable/driver_bottom"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mapinfo_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/driver_map_info"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tripdetail_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@color/transparent"
                android:orientation="vertical"
                android:visibility="visible">
                <!-- android:background="@drawable/bottom" -->


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/tripDetails_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:visibility="visible">


                        <RelativeLayout
                            android:id="@+id/tool_lay"
                            android:layout_width="fill_parent"
                            android:layout_height="@android:dimen/app_icon_size"
                            android:paddingLeft="5dp"
                            android:paddingTop="5dp"
                            android:paddingRight="5dp">

                            <TextView
                                android:id="@+id/back_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:drawableRight="@drawable/driver_back"
                                android:gravity="left"
                                android:padding="5dp"
                                android:rotation="180"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/headerTxt"
                                style="@android:style/TextAppearance.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_horizontal"
                                android:padding="5dp"
                                android:text="@string/tripprogress"
                                android:textColor="@color/header_text" />

                            <TextView
                                android:id="@+id/contact_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_toRightOf="@+id/headerTxt"
                                android:drawableLeft="@drawable/driver_user_unfocus"
                                android:gravity="right"
                                android:padding="8dp"
                                android:visibility="gone" />
                        </RelativeLayout>


                        <View
                            android:id="@+id/trip_view"
                            android:layout_width="wrap_content"
                            android:layout_height="0.1dp"
                            android:layout_below="@+id/tool_lay"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginBottom="5dp"
                            android:background="@color/invite_gray"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/tripinprogress_lay"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/waiting_lay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/wait_time"
                                    android:textColor="@color/popup_heading" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/img_start"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        app:srcCompat="@drawable/driver_ic_play_circle" />

                                    <TextView
                                        android:id="@+id/waittime_txt"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_weight="1"
                                        android:layout_marginRight="@dimen/dp_20"
                                        android:gravity="center"
                                        android:text="00:00:00" />


                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="0.1dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:layout_marginBottom="5dp"
                                android:background="@color/invite_gray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/speed"
                                    android:textColor="@color/popup_heading" />

                                <TextView
                                    android:id="@+id/speedTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.00km/hr" />
                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/view_tool"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_below="@+id/view_tool"
                        android:foreground="@drawable/driver_background_shadow_light"
                        android:visibility="visible">
                        <!-- YOUR STUFF HERE -->
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/pickup_drop_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:paddingLeft="1dp"
                            android:paddingTop="1dp"
                            android:paddingRight="1dp">


                            <FrameLayout
                                android:id="@+id/contact_lay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="2dp"
                                android:background="@color/transparent"
                                android:visibility="visible">

                                <RelativeLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="40dp"
                                    android:background="@color/white">

                                    <TextView
                                        android:id="@+id/phoneTxt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:autoText="true"
                                        android:background="@color/white"
                                        android:drawableRight="@drawable/driver_phone_bg"
                                        android:drawablePadding="5dp"
                                        android:ellipsize="end"
                                        android:maxLength="20"
                                        android:paddingTop="10dp"
                                        android:paddingRight="10dp"
                                        android:text="@string/call_passeneger"
                                        android:textColor="@color/button_accept"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/TripcancelTxt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:background="@color/white"
                                        android:drawableRight="@drawable/driver_cancel"
                                        android:drawablePadding="5dp"
                                        android:gravity="center"
                                        android:paddingLeft="15dp"
                                        android:paddingTop="10dp"
                                        android:text="@string/cancell"
                                        android:textColor="@color/button_accept"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/passnameTxt"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/phoneTxt"
                                        android:layout_gravity="center"

                                        android:ellipsize="end"
                                        android:gravity="center"

                                        android:maxLines="2"
                                        android:padding="5dp"
                                        android:text=""
                                        android:textColor="@color/textviewcolor_dark"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:id="@+id/timerlayout"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/passnameTxt"
                                        android:layout_centerHorizontal="true"
                                        android:background="@color/white"
                                        android:gravity="center"
                                        android:orientation="horizontal"
                                        android:visibility="gone">


                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="10dp"
                                            android:background="@color/white"
                                            android:paddingLeft="5dp"
                                            android:text="@string/m_timer"
                                            android:textColor="@color/black"
                                            android:textSize="18sp"
                                            android:visibility="visible" />

                                        <TextView
                                            android:id="@+id/waitingTxtnew"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_horizontal"
                                            android:tag="start"
                                            android:text="@string/waiting_time"
                                            android:textColor="@color/black"
                                            android:textSize="18sp" />
                                    </LinearLayout>

                                </RelativeLayout>

                                <com.taximobility.driver.utils.DriverRoundedImageView
                                    android:id="@+id/proimg"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center_horizontal"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/driver_loadingimage" />


                                <!--
                                     <TextView
                                    android:id="@+id/editTxt"
                                    android:layout_width="100dip"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/profileimg_bottom"
                                    android:gravity="center"
                                    android:text="@string/edit" />
                                -->

                            </FrameLayout>

                            <!-- <RelativeLayout
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:layout_gravity="center_vertical"
                                 android:background="@color/white">

                                 <TextView
                                     android:id="@+id/close_icon"
                                     android:layout_width="wrap_content"
                                     android:layout_height="wrap_content"
                                     android:layout_alignParentRight="true"
                                     android:layout_centerVertical="true"
                                     android:layout_gravity="center_vertical"
                                     android:layout_margin="5dp"
                                     android:layout_marginRight="10dp"
                                     android:gravity="center_vertical" />


                                 <TextView
                                     android:id="@+id/line"
                                     android:layout_width="0.3dp"
                                     android:layout_height="20dp"
                                     android:layout_centerVertical="true"
                                     android:layout_toRightOf="@+id/TripcancelTxt"
                                     android:background="@color/white" />



                                 <TextView
                                     android:id="@+id/hideline"
                                     android:layout_width="wrap_content"
                                     android:layout_height="wrap_content"
                                     android:layout_centerVertical="true"
                                     android:layout_gravity="center"
                                     android:layout_toLeftOf="@id/phoneImg"
                                     android:ellipsize="end"
                                     android:maxLength="20"
                                     android:padding="5dp"
                                     android:textSize="14sp"
                                     android:textStyle="bold"
                                     android:visibility="gone" />


                             </RelativeLayout>-->
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/view_line_trip"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_below="@+id/slide_lay"
                            android:foreground="@drawable/driver_background_shadow_light"
                            android:visibility="visible">
                            <!-- YOUR STUFF HERE -->
                        </FrameLayout>

                        <View
                            android:layout_width="fill_parent"
                            android:layout_height="1dp"
                            android:background="#C9C8C8"
                            android:visibility="gone" />

                        <include
                            layout="@layout/driver_pick_drop"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />

                        <com.taximobility.driver.pdview.DriverPickupDropView
                            android:id="@+id/pdview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_margin="10dp"
                            android:background="@drawable/driver_elevated_bg"
                            android:elevation="8dp"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal"
                            android:visibility="gone">


                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:background="@color/white"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical">


                                <RelativeLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@color/white">

                                    <ImageView
                                        android:id="@+id/imageView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="10dp"
                                        android:paddingTop="5dp"
                                        android:paddingRight="10dp"
                                        app:srcCompat="@drawable/driver_green" />


                                    <TextView
                                        style="@android:style/TextAppearance.Small"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_toRightOf="@+id/imageView"
                                        android:clickable="false"
                                        android:ellipsize="end"
                                        android:gravity="center_vertical"
                                        android:maxLines="3"
                                        android:paddingLeft="5dp"
                                        android:paddingTop="5dp"
                                        android:scrollHorizontally="true"
                                        android:singleLine="false"
                                        android:textColor="@color/textviewcolor_dark" />
                                </RelativeLayout>


                                <View
                                    android:id="@+id/viewborder"
                                    android:layout_width="fill_parent"

                                    android:layout_height="0.5dp"
                                    android:layout_below="@+id/phoneEdt"

                                    android:background="@color/bordercolor" />


                                <RelativeLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone">

                                    <ImageView
                                        android:id="@+id/img"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:paddingRight="10dp"
                                        app:srcCompat="@drawable/driver_red" />


                                    <TextView
                                        style="@android:style/TextAppearance.Small"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_toRightOf="@+id/img"
                                        android:layout_weight="1"
                                        android:clickable="false"
                                        android:ellipsize="end"
                                        android:gravity="center_vertical"
                                        android:maxLines="3"
                                        android:paddingLeft="5dp"
                                        android:scrollHorizontally="true"
                                        android:singleLine="false"
                                        android:textColor="@color/textviewcolor_dark" />

                                </RelativeLayout>


                                <TextView
                                    android:id="@+id/notes"
                                    style="@android:style/TextAppearance.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:clickable="false"
                                    android:ellipsize="end"
                                    android:gravity="center_vertical"
                                    android:maxLines="3"
                                    android:paddingLeft="8dp"
                                    android:scrollHorizontally="true"
                                    android:singleLine="false"
                                    android:textColor="@color/textviewcolor_dark"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/stop_listview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:nestedScrollingEnabled="false" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/drop_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="3dp"
                            android:visibility="visible">


                            <TextView
                                android:id="@+id/drop_txt"
                                android:layout_width="fill_parent"
                                android:layout_height="30dp"
                                android:layout_marginRight="5dp"
                                android:layout_weight="0.2"
                                android:ellipsize="marquee"
                                android:fadingEdge="horizontal"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:gravity="center"
                                android:hint="@string/picklocation"
                                android:lines="1"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:textColor="@color/black"
                                android:textColorHint="@color/hintcolor"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/drop_pin"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:paddingRight="8dp"
                                app:srcCompat="@drawable/driver_circle_red"
                                android:visibility="visible" />


                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_emergency_contact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_3"
                            android:layout_marginRight="5dp"
                            android:background="@drawable/driver_emergency_contact_btn"
                            android:backgroundTint="@color/button_accept"
                            android:gravity="center"
                            android:maxWidth="120dp"
                            android:minWidth="70dp"
                            android:minHeight="30dp"
                            android:paddingLeft="7dp"
                            android:paddingRight="7dp"
                            android:text="@string/emergency"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/bottomlay"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom"
            android:gravity="center">

            <Button
                android:id="@+id/butt_onboard"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@color/button_accept"
                android:gravity="center"
                android:padding="5dp"
                android:tag="Arrived"
                android:textAllCaps="false"
                android:textColor="@drawable/driver_text_color_black_to_white" />
        </RelativeLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/mov_cur_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottomlay"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="05dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="150dp"
            android:clickable="true"
            android:gravity="center|right"
            android:src="@drawable/driver_current_loc"
            android:visibility="visible"
            app:backgroundTint="@android:color/white"
            app:fabCustomSize="50dp"
            app:layout_anchor="@+id/searchlay"
            app:layout_anchorGravity="bottom|left" />

        <RelativeLayout
            android:id="@+id/botton_layout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_above="@+id/bottomlay"
            android:layout_alignParentLeft="true"
            android:layout_marginBottom="150dp"
            android:gravity="center|right">

            <ImageView
                android:id="@+id/butt_navigator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="05dp"
                android:gravity="right"
                app:srcCompat="@drawable/driver_gps_navigator" />
        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>