<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:background="@color/appbg">

        <TextView
            android:id="@+id/slideImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:drawableLeft="@drawable/driver_back"
            android:rotation="180"
            android:drawablePadding="5dp"
            android:padding="15dp"

            android:textColor="@color/button_accept"
            android:textSize="16sp"
            android:visibility="visible" />


        <LinearLayout
            android:id="@+id/km_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@color/transparent"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="invisible">

            <TextView
                android:id="@+id/total_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/total_km"

                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@drawable/driver_green_to_white"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/waiting_time"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/draw_timer_bg"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerTxt"
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:text="@string/trip_history"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/headicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/headerTxt"
            android:gravity="center"
            app:srcCompat="@drawable/driver_headicon"
            android:visibility="gone" />


    </RelativeLayout>

    <FrameLayout android:layout_width="match_parent"
        android:layout_height="5dp"
        android:id="@+id/shadow"
        android:visibility="visible"
        android:layout_below="@+id/slide_lay"
        android:foreground="@drawable/driver_background_shadow">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>

    <FrameLayout
        android:id="@+id/mainFrag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        />
</LinearLayout>