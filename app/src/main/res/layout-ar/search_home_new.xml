<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchlay"
    android:layout_width="fill_parent"
    android:layout_height="81dp"
    android:layout_marginLeft="03dp"
    android:layout_marginRight="3dp"
    android:background="@color/transparent"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/dropppp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/pickup_drop_Sep"
        android:layout_toRightOf="@id/pickup_pinlay"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible">


        <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:layout_marginLeft="3dp"
            card_view:cardCornerRadius="2dp"
            card_view:cardElevation="5dp"
            card_view:cardUseCompatPadding="true">

            <RelativeLayout
                android:id="@+id/drop_loc_lay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/actionbar"
                android:layout_margin="5dp"
                android:onClick="ClickMethod"
                android:layout_gravity="center_vertical"
                android:gravity="right"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_toLeftOf="@+id/drop_ic"
                    android:layout_toRightOf="@+id/view"
                    android:gravity="right|center"
                    android:text="@string/droploc_c"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/drop_ic"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:src="@drawable/droplocation1"
                    android:textColor="@color/black" />

            </RelativeLayout>


        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>
