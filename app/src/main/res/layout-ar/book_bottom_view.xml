<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="android.view.View" />

        <variable
            name="myBookViewModel"
            type="com.taximobility.bookingmodule.BookTaxiHomeViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/select_car_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/transparent"
        android:orientation="vertical"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/linebottom_light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cash_card_lay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:onClick="@{() -> myBookViewModel.cashCardClick()}"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cash_card"
                    style="@style/enterTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/cash_b"
                    android:drawablePadding="5dp"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:enabled="@{myBookViewModel.cashCardEnable}"
                    android:paddingBottom="5dp"
                    android:text="@{myBookViewModel.payType}"
                    android:textSize="@dimen/text_dialog_small" />

                <TextView
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/eta"
                    android:textColor="@color/hintcolor"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:background="@color/linebottom_light" />

            <LinearLayout
                android:id="@+id/promo_code_lay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/enterTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/promo_b"
                    android:drawablePadding="5dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="@string/promo"
                    android:textSize="@dimen/text_dialog_small" />

                <TextView
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/minimum_fare"
                    android:textColor="@color/hintcolor"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/linebottom_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fare_minimum_ppl"
                    style="@style/enterTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/people_num"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:textSize="@dimen/text_dialog_small" />

                <TextView
                    style="@style/enterTxt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/max_size"
                    android:textColor="@color/hintcolor"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/requestBooking"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textRequestTaxi"
                    style="@style/enterTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center_vertical"
                    android:layout_toEndOf="@+id/textBookLater"
                    android:background="@color/button_accept"
                    android:gravity="center"
                    android:text="@string/car_not_available"
                    android:textColor="@color/buttontextcolor" />

                <TextView
                    android:id="@+id/textBookLater"
                    style="@style/enterTxt"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:layout_marginEnd="0.3dp"
                    android:background="@color/button_accept"
                    android:drawableStart="@drawable/timer"
                    android:padding="15dp"
                    android:textColor="@color/buttontextcolor" />
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/button_accept"
            android:gravity="center"
            android:visibility="gone"
            android:id="@+id/corporateBooking"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/corporateBookLater"
                style="@style/enterTxt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/book_ride"
                android:textColor="@color/buttontextcolor" />

        </LinearLayout>

    </LinearLayout>
</layout>