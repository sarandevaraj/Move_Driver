<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ongoing_lay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical">
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/no_taxi_view"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/no_taxi_assigned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:textColor="@color/white"
            android:padding="15dp"
            android:gravity="center"
            android:background="@color/button_accept" />
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/slide_lay"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/tool_bar"
        android:background="@color/header_bgcolor">

        <TextView
            android:id="@+id/slideImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:drawablePadding="5dp"
            android:drawableRight="@drawable/driver_back"
            android:padding="5dp"
            android:rotation="180"
            android:textColor="@color/button_accept"
            android:textSize="16sp"
            android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btn_emergency"
            android:background="@drawable/driver_emergency_contact_btn"
            android:text="@string/emergency"
            android:textAllCaps="false"
            android:gravity="center"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:textColor="@color/white"
            android:minWidth="70dp"
            android:maxWidth="120dp"
            android:minHeight="30dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:textSize="12sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/backup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:drawableLeft="@drawable/driver_backbtn"
            android:gravity="left"
            android:padding="5dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/km_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@color/transparent"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="invisible">

            <TextView
                android:id="@+id/total_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/total_km"

                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="2dp"
            android:background="@drawable/driver_green_to_white"
            android:gravity="left"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:scrollHorizontally="true"
                android:tag="start"
                android:text="@string/waiting_time"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/draw_timer_bg"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/m_timer"
                android:textColor="@drawable/driver_text_color_black_to_white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerTxt"
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:text="@string/app_name"
            android:visibility="gone"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/headicon"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_centerInParent="true"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/headerTxt"
            android:gravity="center"

            app:srcCompat="@drawable/driver_headicon"
            android:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btn_shift"
            android:background="@drawable/driver_shiftbg"
            android:text="Online"
            android:gravity="center"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:textColor="@color/white"
            android:minWidth="70dp"
            android:maxWidth="120dp"
            android:minHeight="30dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:textSize="12sp"/>

    </RelativeLayout>
    <FrameLayout android:layout_width="match_parent"
        android:layout_height="5dp"
        android:id="@+id/shadow"
        android:visibility="visible"
        android:foreground="@drawable/driver_background_shadow">
        <!-- YOUR STUFF HERE -->
    </FrameLayout>
    <LinearLayout
        android:id="@+id/progresss"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/nodataTxt"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:gravity="center"
            android:visibility="visible" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/mapsupport_lay"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/white"
        android:visibility="visible">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            >
            <com.taximobility.driver.utils.DriverStreetMapWrapperLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/map_relative_layout"
                android:layout_width="fill_parent"

                android:layout_height="fill_parent"
                android:orientation="vertical" >

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />

            </com.taximobility.driver.utils.DriverStreetMapWrapperLayout>
            <ImageView
                android:id="@+id/map_icon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:paddingBottom="30dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:srcCompat="@drawable/driver_flag_green"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/tripdetail_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <include
                layout="@layout/driver_home_top_navigation"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />

            <RelativeLayout
                android:id="@+id/searchlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="5dp"
                        android:id="@+id/card_view_pickup"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <FrameLayout
                            android:id="@+id/pickup_pinlay"
                            android:layout_width="wrap_content"
                            android:layout_height="91dp"
                            android:layout_alignParentLeft="true"
                            android:layout_gravity="end"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/drop_pin"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:paddingRight="5dp"
                                app:srcCompat="@drawable/driver_location" />
                        </FrameLayout>


                        <LinearLayout
                            android:id="@+id/pickupp"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_toRightOf="@+id/pickup_pinlay"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:paddingLeft="3dp"
                                android:paddingRight="3dp"
                                android:id="@+id/pickup_location_txt"
                                android:text="@string/pickup_location"
                                android:textColor="@color/popup_heading"
                                android:textSize="12sp" />


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/tapCurrentLocation"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/lay_pick_fav"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:paddingBottom="5dp"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:paddingTop="5dp"
                                    android:visibility="visible">

                                    <ImageView
                                        android:id="@+id/pick_fav"
                                        android:layout_width="15dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        app:srcCompat="@drawable/driver_plus1"
                                        android:visibility="visible" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/currentlocTxt"
                                    android:layout_width="fill_parent"
                                    android:layout_height="30dp"
                                    android:layout_marginRight="5dp"
                                    android:layout_weight="0.2"
                                    android:ellipsize="marquee"
                                    android:fadingEdge="horizontal"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:gravity="center"
                                    android:hint="@string/picklocation"
                                    android:lines="1"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/hintcolor"
                                    android:textSize="15sp" />

                                <ImageView
                                    android:id="@+id/pickup_pin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:paddingRight="8dp"
                                    app:srcCompat="@drawable/driver_dot"
                                    android:visibility="visible" />


                            </LinearLayout>


                            <View
                                android:id="@+id/pickup_drop_Sep"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:visibility="gone"
                                android:layout_below="@id/pickupp"
                                android:background="@color/linebottom_light" />

                            <LinearLayout
                                android:id="@+id/dropppp"
                                android:layout_width="fill_parent"
                                android:layout_height="30dp"
                                android:layout_below="@id/pickup_drop_Sep"
                                android:layout_toLeftOf="@id/pickup_pinlay"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <LinearLayout
                                    android:id="@+id/drop_fav"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:paddingBottom="5dp"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:paddingTop="5dp"
                                    android:visibility="gone">

                                    <ImageView
                                        android:id="@+id/drop_close"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        app:srcCompat="@drawable/driver_close" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/droplocTxt"
                                    android:layout_width="fill_parent"
                                    android:layout_height="30dp"
                                    android:layout_marginRight="15dp"
                                    android:layout_weight="0.2"
                                    android:ellipsize="marquee"
                                    android:fadingEdge="horizontal"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:gravity="center"
                                    android:hint="@string/droplocnew"
                                    android:lines="1"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:padding="5dp"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/hintcolor"
                                    android:textSize="15sp" />
                                <ImageView
                                    android:id="@+id/initial_drop_pin"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center"
                                    android:paddingRight="8dp"
                                    app:srcCompat="@drawable/driver_circle_red"
                                    android:visibility="gone" />

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>
            </RelativeLayout>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_currentloc_initial"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="left"
                android:layout_marginLeft="5dp"
                android:paddingBottom="5dp"
                android:paddingLeft="05dp"
                android:paddingRight="5dp"
                android:paddingTop="5dp"
                app:fabCustomSize="50dp"
                app:srcCompat="@drawable/driver_current_loc"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:layout_anchor="@id/searchlay"
                app:layout_anchorGravity="bottom|left" />
        </LinearLayout>


        <RelativeLayout
            android:id="@+id/bottomlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom"
            >


            <include
                layout="@layout/driver_ongoing_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center" />
            <!-- <Button
                 android:id="@+id/butt_onboard"
                 android:layout_width="fill_parent"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:background="@drawable/back_black_to_white"
                 android:gravity="center"
                 android:padding="5dp"
                 android:tag="Arrived"
                 android:textColor="@drawable/text_color_black_to_white" />-->
        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>